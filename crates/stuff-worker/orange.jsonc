  "r2_buckets": [
    {
      "binding": "MYCRATES",
      "bucket_name": "stuff-mycrates"
    },
    {
      "binding": "MYNPM",
      "bucket_name": "stuff-mynpm"
    },
    {
      "binding": "PYPI",
      "bucket_name": "stuff-mypypi"
    },
    {
      "binding": "OCI",
      "bucket_name": "stuff-oci"
    },
    {
      "binding": "MIRROR",
      "bucket_name": "stuff-mirror"
    },
    {
      "binding": "OCI_BLOBS",
      "bucket_name": "stuff-oci-blobs"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "COORDINATOR",
        "class_name": "PublicationCoordinator"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "PublicationCoordinator"
      ]
    }
  ]
