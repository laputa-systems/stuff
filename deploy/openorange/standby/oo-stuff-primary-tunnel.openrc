#!/sbin/openrc-run

description="Forward Lisa's Stuff replica source to the Threadripper VM store"
supervisor=supervise-daemon
command=/usr/bin/ssh
command_user=josh
directory=/home/josh
export HOME=/home/josh
key_dir=/home/josh/.local/share/stuff-primary
# 18492 is the VM's store for the Lisa replica sync.
command_args="-J threadripper -o BatchMode=yes -o IdentitiesOnly=yes -o ExitOnForwardFailure=yes -o ServerAliveInterval=15 -o ServerAliveCountMax=3 -o HostKeyAlias=stuff-primary -o UserKnownHostsFile=$key_dir/known_hosts -o StrictHostKeyChecking=yes -i $key_dir/forward -p 49187 -NT -L 127.0.0.1:18492:172.29.80.10:7070 root@127.0.0.1"
output_log="$key_dir/tunnel.log"
error_log="$key_dir/tunnel.log"
respawn_delay=3
respawn_max=0
respawn_period=60

depend() {
    need net tailscale
}
