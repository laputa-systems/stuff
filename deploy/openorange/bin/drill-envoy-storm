#!/usr/bin/env python3
"""Run an isolated envoy-refusal contention drill against two Engine images."""
import argparse
import base64
import json
import os
import re
import secrets
import signal
import socket
import struct
import subprocess
import sys
import threading
import time
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path

sys.path.insert(0, str(Path(os.path.realpath(__file__)).parent.parent / "lib"))
import oolib

CANDIDATE_IMAGE = "sha256:7df2c2be40ce9d4fa40ddccc4ae20383088b9a5b38754ea94d7430c7c5e74918"
PROTOCOL_VERSION = 9
METADATA_FRAME = bytes((0, 0, 0))
REFUSAL_LOG = "refusing envoy connect that storage could not register"
DISCONNECT_RETRY_LOG = "retrying envoy disconnect write"
DISCONNECT_FAILED_LOG = "envoy disconnect write failed"
DEVICE_TOTAL_RE = re.compile(r"^(\d+):(\d+)$")


class Interrupted(BaseException):
    def __init__(self, number):
        self.number = number


def interrupt(number, _frame):
    raise Interrupted(number)


def count_log(text):
    retries = text.count(DISCONNECT_RETRY_LOG)
    failures = text.count(DISCONNECT_FAILED_LOG)
    return {
        "refused_connects": text.count(REFUSAL_LOG),
        "disconnect_writes": retries + failures,
        "disconnect_retries": retries,
        "disconnect_failures": failures,
    }


def per_refusal(disconnect_writes, refused_connects):
    return None if not refused_connects else disconnect_writes / refused_connects


def encode_metadata():
    return METADATA_FRAME


def encode_pong(ts):
    return bytes((4,)) + struct.pack("<q", ts)


def parse_close(payload):
    if len(payload) < 2:
        return 1005, ""
    return struct.unpack(">H", payload[:2])[0], payload[2:].decode("utf-8", "replace")


def verdict(candidate, upstream):
    candidate_ok = (
        candidate["refused_connects"] > 0
        and candidate["disconnect_writes"] == 0
        and candidate["drain_seconds"] is not None
        and candidate["quiesce_seconds"] is not None
    )
    upstream_ok = (
        upstream["refused_connects"] > 0
        and upstream["disconnect_writes"] >= upstream["refused_connects"]
        and upstream["drain_seconds"] is not None
        and upstream["quiesce_seconds"] is not None
    )
    return candidate_ok and upstream_ok, candidate_ok, upstream_ok


def docker(*args, check=True, capture=True, timeout=180, input=None):
    return subprocess.run(["docker", *args], check=check, capture_output=capture, text=True, timeout=timeout, input=input)


def docker_text(*args, **kwargs):
    result = docker(*args, **kwargs)
    return (result.stdout or "") + (result.stderr or "")


def private_file(path, text):
    path.parent.mkdir(parents=True, exist_ok=True)
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as out:
        out.write(text)


def without_rm(args):
    return [arg for arg in args if arg != "--rm"]


def with_logs(args):
    kept = []
    skip = False
    for arg in args:
        if skip:
            skip = False
            continue
        if arg == "--log-driver":
            skip = True
            continue
        kept.append(arg)
    return kept


def open_tree(path):
    path.mkdir(parents=True, exist_ok=True)
    path.chmod(0o777)
    return path


class FrameReader:
    def __init__(self, sock, leftover=b""):
        self.sock = sock
        self.buffer = bytearray(leftover)

    def exact(self, size, timeout):
        deadline = time.monotonic() + timeout
        while len(self.buffer) < size:
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                raise TimeoutError("websocket read timed out")
            self.sock.settimeout(remaining)
            chunk = self.sock.recv(65536)
            if not chunk:
                raise ConnectionError("websocket closed")
            self.buffer.extend(chunk)
        out = bytes(self.buffer[:size])
        del self.buffer[:size]
        return out

    def read(self, timeout):
        head = self.exact(2, timeout)
        opcode = head[0] & 0x0F
        masked = bool(head[1] & 0x80)
        length = head[1] & 0x7F
        if length == 126:
            length = struct.unpack(">H", self.exact(2, timeout))[0]
        elif length == 127:
            length = struct.unpack(">Q", self.exact(8, timeout))[0]
        mask = self.exact(4, timeout) if masked else None
        payload = self.exact(length, timeout) if length else b""
        if mask:
            payload = bytes(byte ^ mask[index % 4] for index, byte in enumerate(payload))
        return opcode, payload


def send_frame(sock, opcode, payload):
    mask = os.urandom(4)
    size = len(payload)
    header = bytes((0x80 | opcode,))
    if size < 126:
        header += bytes((0x80 | size,))
    elif size < 65536:
        header += bytes((0x80 | 126,)) + struct.pack(">H", size)
    else:
        header += bytes((0x80 | 127,)) + struct.pack(">Q", size)
    sock.sendall(header + mask + bytes(byte ^ mask[index % 4] for index, byte in enumerate(payload)))


def handshake(sock, host, port, token, namespace, pool, envoy_key, version=1):
    key = base64.b64encode(os.urandom(16)).decode()
    protocols = ["rivet"]
    if token:
        protocols.append(f"rivet_token.{token}")
    path = (
        f"/envoys/connect?protocol_version={PROTOCOL_VERSION}"
        f"&namespace={urllib.parse.quote(namespace)}"
        f"&envoy_key={urllib.parse.quote(envoy_key)}"
        f"&version={version}"
        f"&pool_name={urllib.parse.quote(pool)}"
    )
    request = "\r\n".join([
        f"GET {path} HTTP/1.1",
        f"Host: {host}:{port}",
        "Upgrade: websocket",
        "Connection: Upgrade",
        f"Sec-WebSocket-Key: {key}",
        "Sec-WebSocket-Version: 13",
        f"Sec-WebSocket-Protocol: {', '.join(protocols)}",
        "",
        "",
    ]).encode()
    sock.sendall(request)
    response = bytearray()
    while b"\r\n\r\n" not in response:
        chunk = sock.recv(4096)
        if not chunk:
            raise ConnectionError("handshake closed")
        response.extend(chunk)
        if len(response) > 65536:
            raise ConnectionError("handshake too large")
    head, _, leftover = bytes(response).partition(b"\r\n\r\n")
    status = head.split(b"\r\n", 1)[0].decode("latin-1")
    if " 101 " not in status:
        raise ConnectionError(f"handshake refused: {status}")
    return leftover


class Client:
    def __init__(self, host, port, token, namespace, pool, prefix, timeout):
        self.host = host
        self.port = port
        self.token = token
        self.namespace = namespace
        self.pool = pool
        self.prefix = prefix
        self.timeout = timeout
        self.lock = threading.Lock()
        self.counts = {"refused": 0, "registered": 0, "timeout": 0, "failed": 0}
        self.attempting = 0

    def bump(self, key):
        with self.lock:
            self.counts[key] += 1

    def attempting_start(self):
        with self.lock:
            self.attempting += 1

    def attempting_done(self):
        with self.lock:
            self.attempting -= 1

    def connect_once(self, envoy_key, hold):
        sock = socket.create_connection((self.host, self.port), timeout=self.timeout)
        try:
            leftover = handshake(sock, self.host, self.port, self.token, self.namespace, self.pool, envoy_key)
            reader = FrameReader(sock, leftover)
            send_frame(sock, 2, encode_metadata())
            deadline = time.monotonic() + self.timeout
            while True:
                remaining = deadline - time.monotonic()
                if remaining <= 0:
                    self.bump("timeout")
                    return "timeout"
                opcode, payload = reader.read(min(remaining, 1.0))
                if opcode == 2:
                    if payload[:1] == b"\x00":
                        self.bump("registered")
                        return self.hold(sock, reader, hold) if hold is not None else "registered"
                    if payload[:1] == b"\x05":
                        send_frame(sock, 2, encode_pong(struct.unpack("<q", payload[1:9])[0]))
                elif opcode == 8:
                    code, reason = parse_close(payload)
                    if code == 1013 or "connect_unavailable" in reason:
                        self.bump("refused")
                        return "refused"
                    self.bump("failed")
                    return f"close:{code}"
                elif opcode == 9:
                    send_frame(sock, 10, payload)
                else:
                    continue
        except (TimeoutError, OSError, ConnectionError):
            self.bump("failed")
            return "failed"
        finally:
            sock.close()

    def hold(self, sock, reader, stop):
        try:
            while not stop.is_set():
                try:
                    opcode, payload = reader.read(1.0)
                except TimeoutError:
                    continue
                if opcode == 2 and payload[:1] == b"\x05":
                    send_frame(sock, 2, encode_pong(struct.unpack("<q", payload[1:9])[0]))
                elif opcode == 8:
                    return "closed"
                elif opcode == 9:
                    send_frame(sock, 10, payload)
        except (TimeoutError, OSError, ConnectionError):
            pass
        return "registered"

    def load(self, index, stop_new, close_held, reconnect):
        generation = 0
        while not stop_new.is_set():
            envoy_key = f"{self.prefix}-{index}-{generation}"
            generation += 1
            self.attempting_start()
            try:
                outcome = self.connect_once(envoy_key, close_held)
            finally:
                self.attempting_done()
            if outcome == "registered" or stop_new.is_set():
                break
            stop_new.wait(reconnect)

    def probe(self, reconnect, deadline):
        generation = 0
        while time.monotonic() < deadline:
            envoy_key = f"{self.prefix}-probe-{generation}"
            generation += 1
            if self.connect_once(envoy_key, None) == "registered":
                return time.monotonic()
            time.sleep(reconnect)
        return None


def http(url, token=None, method="GET", body=None, timeout=10):
    headers = {}
    if token:
        headers["Authorization"] = f"Bearer {token}"
    data = None
    if body is not None:
        data = json.dumps(body).encode()
        headers["Content-Type"] = "application/json"
    request = urllib.request.Request(url, data=data, method=method, headers=headers)
    try:
        with urllib.request.urlopen(request, timeout=timeout) as response:
            return response.status, response.read(1 << 20)
    except urllib.error.HTTPError as error:
        return error.code, error.read(1 << 20)
    except (urllib.error.URLError, OSError):
        return 0, b""


def wait_http(url, token, deadline):
    while time.monotonic() < deadline:
        status, _ = http(url, token, timeout=2)
        if status == 200:
            return
        time.sleep(0.25)
    raise RuntimeError(f"service did not become healthy: {url}")


def wait_running(name, deadline):
    while time.monotonic() < deadline:
        state = docker_text("inspect", "--format", "{{.State.Running}} {{.State.ExitCode}}", name, check=False).strip()
        if state.startswith("true"):
            return
        if state:
            raise RuntimeError(f"{name} exited: {state}\n{docker_text('logs', name, check=False)}")
        time.sleep(0.25)
    raise RuntimeError(f"{name} did not start")


def wait_quiescent(engine, idle_seconds, deadline):
    previous = None
    stable_since = time.monotonic()
    while time.monotonic() < deadline:
        counts = count_log(docker_text("logs", engine))
        total = counts["refused_connects"] + counts["disconnect_writes"]
        if previous is None or total != previous:
            previous = total
            stable_since = time.monotonic()
        elif time.monotonic() - stable_since >= idle_seconds:
            return time.monotonic()
        time.sleep(0.25)
    return None


def device_of(path):
    device = os.stat(path).st_dev
    block = (Path("/sys/dev/block") / f"{os.major(device)}:{os.minor(device)}").resolve()
    if (block / "partition").exists():
        block = block.parent
    value = (block / "dev").read_text().strip()
    if not DEVICE_TOTAL_RE.match(value):
        raise RuntimeError(f"unexpected block device for {path}: {value}")
    return value


def cgroup_of(container):
    cid = docker("inspect", "--format", "{{.Id}}", container).stdout.strip()
    if not re.fullmatch(r"[0-9a-f]{64}", cid):
        raise RuntimeError(f"unexpected container id for {container}")
    return f"/docker/{cid}"


def set_write_limit(cgroup, device, bytes_per_second):
    value = "max" if bytes_per_second is None else str(bytes_per_second)
    command = f'echo "{device} wbps={value}" > /sys/fs/cgroup{cgroup}/io.max'
    result = subprocess.run(["doas", "-n", "sh", "-c", command], capture_output=True, text=True)
    if result.returncode:
        raise RuntimeError(f"could not set io.max: {result.stderr.strip()}")
    observed = subprocess.run(["doas", "-n", "cat", f"/sys/fs/cgroup{cgroup}/io.max"], capture_output=True, text=True)
    return observed.stdout.strip()


def engine_config(bucket, store_ip):
    return {
        "storage": {
            "log_directory": "/var/lib/rivet/log",
            "auto_provision_partitions": 1,
            "balancing": {"enabled": False},
            "log_shard": {"max_disk_bytes": 1073741824},
            "cold_store": {"disk_cache_bytes": 0},
        },
        "object_storage": {"primary": {"s3": {"bucket": bucket, "region": "us-east-1", "endpoint": f"http://{store_ip}:{oolib.STORE_PORT}"}}},
        "telemetry": {"enabled": False},
    }


class Drill:
    def __init__(self, args, kind, image):
        self.args = args
        self.kind = kind
        self.image = image
        self.run_id = secrets.token_hex(6)
        root = Path(args.tmp) / f"drill-envoy-storm-{self.run_id}-{kind}"
        self.root = root
        self.network = f"drill-net-{kind}-{self.run_id}"
        self.store_name = f"drill-store-{kind}-{self.run_id}"
        self.engine_name = f"drill-engine-{kind}-{self.run_id}"
        self.probe_name = f"drill-probe-{kind}-{self.run_id}"
        self.resources = []
        self.token = secrets.token_hex(24)
        self.access = secrets.token_hex(12)
        self.secret = secrets.token_hex(24)
        self.bucket = "engine-" + secrets.token_hex(6)
        self.prefix = f"drill-{self.run_id}-{kind}"
        self.cfg = None
        self.store_ip = None
        self.engine_ip = None
        self.probe_ip = None
        self.subnet = None

    def setup(self):
        self.root.mkdir(parents=True, mode=0o700)
        octet = 100 + secrets.randbelow(120)
        self.subnet = f"172.31.{octet}.0/24"
        self.store_ip = f"172.31.{octet}.10"
        self.engine_ip = f"172.31.{octet}.11"
        self.probe_ip = f"172.31.{octet}.12"
        raw = {
            "schema": 1,
            "stack": {
                "code_dir": str(self.root),
                "state_dir": str(self.root / "state"),
                "etc_dir": str(self.root / "etc"),
                "log_dir": str(self.root / "log"),
                "run_dir": str(self.root / "run"),
            },
            "network": {
                "name": self.network,
                "bridge": "d0",
                "subnet": self.subnet,
                "internal": True,
                "store_ip": self.store_ip,
                "engine_ip": self.engine_ip,
            },
            "ingress": {"bind": "127.0.0.1", "tls": "internal", "dns_env_file": "/dev/null"},
            "store": {"region": "us-east-1"},
            "apps": {},
        }
        self.cfg = oolib.validate(raw)
        for sub in ("etc", "state", "log", "run"):
            open_tree(self.root / sub)
        for sub in ("store/data", "store/versions", "store/iam", "store/admin", "engine/log", "engine/objects"):
            open_tree(self.root / sub)
        store_env = self.root / "etc/store.env"
        private_file(store_env, f"ROOT_ACCESS_KEY={self.access}\nROOT_SECRET_KEY={self.secret}\n")
        engine_env = self.root / "etc/engine.env"
        private_file(engine_env, "\n".join([
            "RIVET_CONFIG_PATH=/etc/rivet/config.json",
            f"RIVET__AUTH__ADMIN_TOKEN={self.token}",
            f"AWS_ACCESS_KEY_ID={self.access}",
            f"AWS_SECRET_ACCESS_KEY={self.secret}",
            "AWS_ALLOW_HTTP=true",
            "RUST_LOG=info,pegboard_envoy=debug",
            f"RIVET__PEGBOARD__NODE_CONNECT_ADMISSIONS_PER_SECOND={max(1000, self.args.clients * 50)}",
            f"RIVET__PEGBOARD__NODE_CONNECT_ADMISSION_BURST={max(1000, self.args.clients * 50)}",
            "",
        ]))
        config = self.root / "etc/config.json"
        config.write_text(json.dumps(engine_config(self.bucket, self.store_ip)))
        config.chmod(0o644)
        curl = self.root / "etc/curl.conf"
        private_file(curl, f'user = "{self.access}:{self.secret}"\naws-sigv4 = "aws:amz:us-east-1:s3"\n')
        docker("network", "create", "--internal", "--subnet", self.subnet, self.network)
        self.resources.append(("network", self.network))
        self.start_store(store_env)
        self.start_probe(curl)
        self.create_bucket()
        self.start_engine(engine_env, config)

    def start_store(self, env_file):
        args = oolib.store_args(
            self.cfg, self.store_name, self.store_ip, env_file,
            data_dir=self.root / "store/data", versions_dir=self.root / "store/versions",
            iam_dir=self.root / "store/iam", admin_dir=self.root / "store/admin",
            detach=True, image=self.args.store_image,
        )
        args[args.index("run") + 1:args.index("run") + 1] = ["--memory", "512m", "--cpus", str(self.args.store_cpus), "--pids-limit", "128"]
        docker(*with_logs(without_rm(args)))
        self.resources.append(("container", self.store_name))
        wait_running(self.store_name, time.monotonic() + 60)
        wait_http(f"http://{self.store_ip}:{oolib.STORE_PORT}/health", None, time.monotonic() + 30)

    def start_probe(self, curl_file):
        args = [
            "run", "-d", "--name", self.probe_name, "--network", self.network, "--ip", self.probe_ip,
            "--read-only", "--cap-drop", "ALL", "--security-opt", "no-new-privileges",
            "--user", f"{os.getuid()}:{os.getgid()}", "--memory", "64m", "--cpus", "0.1", "--pids-limit", "32",
            "-v", f"{curl_file}:/run/curl.conf:ro", "--entrypoint", "/bin/sleep", self.image, "infinity",
        ]
        docker(*with_logs(without_rm(args)))
        self.resources.append(("container", self.probe_name))
        wait_running(self.probe_name, time.monotonic() + 30)

    def create_bucket(self):
        result = docker(
            "exec", self.probe_name, "curl", "--fail", "--silent", "--show-error", "--max-time", "10",
            "--config", "/run/curl.conf", "--request", "PUT", f"http://{self.store_ip}:{oolib.STORE_PORT}/{self.bucket}",
            check=False,
        )
        if result.returncode:
            raise RuntimeError(f"could not create bucket: {(result.stderr or result.stdout).strip()}")

    def start_engine(self, env_file, config):
        args = oolib.engine_args(
            self.cfg, self.engine_name, self.engine_ip, env_file, config,
            self.root / "engine/log", self.root / "engine/objects", detach=True, image=self.image,
        )
        args[args.index("run") + 1:args.index("run") + 1] = ["--memory", "3g", "--cpus", str(self.args.engine_cpus), "--pids-limit", "512"]
        docker(*with_logs(without_rm(args)))
        self.resources.append(("container", self.engine_name))
        wait_running(self.engine_name, time.monotonic() + 120)
        wait_http(f"http://{self.engine_ip}:{oolib.ENGINE_PORT}/health", self.token, time.monotonic() + 120)

    def prepare_catalog(self):
        deadline = time.monotonic() + 120
        while True:
            status, body = http(f"http://{self.engine_ip}:{oolib.ENGINE_PORT}/namespaces", self.token, "POST", {"name": "drill"})
            if status in (200, 201, 409):
                break
            if time.monotonic() >= deadline or not any(word in body.decode("utf-8", "replace") for word in ("overloaded", "routing_unavailable", "not_ready")):
                raise RuntimeError(f"namespace create failed: {status} {body[:200]!r}")
            time.sleep(0.5)
        pool = {"drain_on_version_upgrade": False, "actor_eviction_delay": 0, "actor_eviction_period": 0, "actor_eviction_rate": 1.0}
        while True:
            status, body = http(f"http://{self.engine_ip}:{oolib.ENGINE_PORT}/pools/default?namespace=drill", self.token, "PUT", pool)
            if status == 200:
                return
            if time.monotonic() >= deadline or not any(word in body.decode("utf-8", "replace") for word in ("overloaded", "routing_unavailable", "not_ready")):
                raise RuntimeError(f"pool create failed: {status} {body[:200]!r}")
            time.sleep(0.5)

    def run(self):
        try:
            self.setup()
            self.prepare_catalog()
            client = Client(self.engine_ip, oolib.ENGINE_PORT, self.token, "drill", "default", self.prefix, self.args.timeout)
            warm_stop = threading.Event()
            warm_result = {}

            def warm():
                warm_result["outcome"] = client.connect_once(f"{self.prefix}-warm", warm_stop)

            warm_thread = threading.Thread(target=warm, daemon=True)
            warm_thread.start()
            deadline = time.monotonic() + self.args.warm_timeout
            while client.counts["registered"] == 0 and time.monotonic() < deadline and warm_thread.is_alive():
                time.sleep(0.05)
            if client.counts["registered"] == 0:
                raise RuntimeError(f"warm envoy did not register: {client.counts} {warm_result}")
            device = device_of(self.root / "engine/log")
            cgroup = cgroup_of(self.engine_name)
            forced = set_write_limit(cgroup, device, self.args.write_bps)
            load_stop = threading.Event()
            close_held = threading.Event()
            workers = [threading.Thread(target=client.load, args=(index, load_stop, close_held, self.args.reconnect_ms / 1000), daemon=True)
                       for index in range(self.args.clients)]
            for worker in workers:
                worker.start()
            time.sleep(self.args.overload_seconds)
            load_stop.set()
            deadline = time.monotonic() + self.args.timeout + 5
            while client.attempting and time.monotonic() < deadline:
                time.sleep(0.05)
            time.sleep(self.args.settle_seconds)
            before = count_log(docker_text("logs", self.engine_name))
            load_counts = dict(client.counts)
            lifted_at = time.monotonic()
            set_write_limit(cgroup, device, None)
            close_held.set()
            for worker in workers:
                worker.join(timeout=10)
            drained_at = client.probe(self.args.reconnect_ms / 1000, time.monotonic() + self.args.drain_timeout)
            after = count_log(docker_text("logs", self.engine_name))
            quiesced_at = wait_quiescent(self.engine_name, 2.0, time.monotonic() + self.args.drain_timeout)
            drain_seconds = None if drained_at is None else round(drained_at - lifted_at, 3)
            quiesce_seconds = None if quiesced_at is None else round(quiesced_at - lifted_at, 3)
            time.sleep(0.5)
            final = count_log(docker_text("logs", self.engine_name))
            warm_stop.set()
            warm_thread.join(timeout=10)
            result = {
                "kind": self.kind,
                "image": self.image,
                "platform": "linux/amd64",
                "clients": self.args.clients,
                "overload_seconds": self.args.overload_seconds,
                "write_bps": self.args.write_bps,
                "device": device,
                "io_max": forced,
                "refused_connects": before["refused_connects"],
                "disconnect_writes": before["disconnect_writes"],
                "disconnect_retries": before["disconnect_retries"],
                "disconnect_failures": before["disconnect_failures"],
                "disconnect_writes_per_refusal": per_refusal(before["disconnect_writes"], before["refused_connects"]),
                "client_refused": load_counts["refused"],
                "client_registered": load_counts["registered"],
                "client_failed": load_counts["failed"],
                "drain_seconds": drain_seconds,
                "quiesce_seconds": quiesce_seconds,
                "drain_phase": {
                    "refused_connects": after["refused_connects"] - before["refused_connects"],
                    "disconnect_writes": after["disconnect_writes"] - before["disconnect_writes"],
                },
                "total_log": final,
                "engine_restarts": 0,
            }
            if self.args.keep:
                result["root"] = str(self.root)
            print(json.dumps(result, sort_keys=True), flush=True)
            return result
        finally:
            self.cleanup()

    def cleanup(self):
        if self.args.keep:
            return
        for kind, name in reversed(self.resources):
            if kind == "container":
                docker("rm", "-f", name, check=False)
            elif kind == "network":
                docker("network", "rm", name, check=False)


def main():
    sys.stdout.reconfigure(line_buffering=True)
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--kind", choices=("candidate", "upstream", "both"), default="both")
    parser.add_argument("--candidate-image", default=CANDIDATE_IMAGE)
    parser.add_argument("--upstream-image", default=None)
    parser.add_argument("--store-image", default=None)
    parser.add_argument("--clients", type=int, default=64)
    parser.add_argument("--overload-seconds", type=int, default=30)
    parser.add_argument("--settle-seconds", type=float, default=8)
    parser.add_argument("--warm-timeout", type=float, default=60)
    parser.add_argument("--timeout", type=float, default=20)
    parser.add_argument("--reconnect-ms", type=int, default=50)
    parser.add_argument("--drain-timeout", type=float, default=120)
    parser.add_argument("--write-bps", type=int, default=1024)
    parser.add_argument("--engine-cpus", type=float, default=2)
    parser.add_argument("--store-cpus", type=float, default=0.5)
    parser.add_argument("--tmp", default=os.environ.get("TMPDIR", str(oolib.ROOT.parents[1] / ".work/tmp")))
    parser.add_argument("--keep", action="store_true")
    args = parser.parse_args()
    if not 1 <= args.clients <= 256:
        parser.error("--clients must be from 1 to 256")
    if args.write_bps < 256:
        parser.error("--write-bps must be at least 256")
    if not 1 <= args.overload_seconds <= 300:
        parser.error("--overload-seconds must be from 1 to 300")
    if args.drain_timeout <= 0 or args.settle_seconds < 0:
        parser.error("--drain-timeout and --settle-seconds must be non-negative")
    Path(args.tmp).mkdir(parents=True, exist_ok=True)
    if subprocess.run(["doas", "-n", "true"], capture_output=True).returncode:
        parser.error("this drill needs passwordless doas for cgroup io.max control")
    locks = oolib.lock()
    upstream = locks["images"]["engine"]["repository"] + "@" + locks["images"]["engine"]["amd64_digest"]
    store = locks["images"]["store"]["repository"] + "@" + locks["images"]["store"]["amd64_digest"]
    if args.upstream_image is None:
        args.upstream_image = upstream
    if args.store_image is None:
        args.store_image = store
    kinds = [("candidate", args.candidate_image), ("upstream", args.upstream_image)]
    if args.kind != "both":
        kinds = [entry for entry in kinds if entry[0] == args.kind]
    results = {}
    for kind, image in kinds:
        if docker("image", "inspect", image, check=False).returncode:
            if image.startswith("sha256:"):
                raise SystemExit(f"{kind} image {image} is not present")
            docker("pull", image)
        drill = Drill(args, kind, image)
        results[kind] = drill.run()
    if len(results) == 2:
        ok, candidate_ok, upstream_ok = verdict(results["candidate"], results["upstream"])
        summary = {"candidate_ok": candidate_ok, "upstream_ok": upstream_ok, "verdict": ok}
        print(json.dumps(summary, sort_keys=True), flush=True)
        return 0 if ok else 1
    return 0


if __name__ == "__main__":
    for number in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP, signal.SIGQUIT):
        signal.signal(number, interrupt)
    try:
        raise SystemExit(main())
    except Interrupted as error:
        signal.signal(error.number, signal.SIG_DFL)
        os.kill(os.getpid(), error.number)
