#!/usr/bin/env python3
"""Fenced, consistent backup of Engine and store state. Run as root.

    backup [--dest DIR] [--keep N] [--no-restart]

Pre-copy the live directories, then stop the stack in drain order so the
Engine flushes and the store holds no open writes. Reconcile every file by
checksum under that fence, restart in reverse order, then checksum the copy.
The live pre-copy alone is never a usable backup.

Contents of one backup directory `<UTC timestamp>/`:
    engine/{log,objects}            Engine log directory + object tier (one unit)
    store/{data,versions,iam}       all application buckets, versions and IAM
    etc/                            /etc/openorange (SECRETS; the directory is 0700)
    apps.toml, images.lock.json     the declarations the backup was taken with
    SHA256SUMS, manifest.json

Loss model: see docs/openorange-runtime.md. The default destination is the same
disk as the data: it protects against operator error and corruption, not disk
loss. Use --dest on another device for that.
"""
import argparse
import fcntl
import json
import os
import shutil
import signal
import subprocess
import sys
import time
from pathlib import Path

sys.path.insert(0, str(Path(os.path.realpath(__file__)).parent.parent / "lib"))
import oolib  # noqa: E402

HERE = Path(os.path.realpath(__file__)).parent


def run(*cmd, check=True):
    return subprocess.run(cmd, check=check, text=True)


def running(svc):
    return subprocess.run(["rc-service", svc, "status"], capture_output=True).returncode == 0


def du(path):
    r = subprocess.run(["du", "-sk", str(path)], capture_output=True, text=True)
    return int(r.stdout.split()[0]) * 1024 if r.returncode == 0 else 0


def copy_state(cfg, out, previous, *, fenced):
    for sub in ("engine/log", "engine/objects", "store/data", "store/versions", "store/iam"):
        source = cfg.state / sub
        target = out / sub
        target.mkdir(parents=True, exist_ok=True)
        links = [f"--link-dest={previous / sub}"] if previous and (previous / sub).exists() else []
        print(f"{'reconcile' if fenced else 'pre-copy'} {sub}")
        priority = [] if fenced else ["ionice", "-c", "3", "nice", "-n", "19"]
        result = run(*priority, "rsync", "-aHX", "--numeric-ids", "--delete", *(["--checksum"] if fenced else []),
                     *links, f"{source}/", f"{target}/", check=False)
        if result.returncode not in ([0] if fenced else [0, 24]):
            raise subprocess.CalledProcessError(result.returncode, result.args)


def main():
    sys.stdout.reconfigure(line_buffering=True)
    ap = argparse.ArgumentParser()
    ap.add_argument("--dest")
    ap.add_argument("--keep", type=int, default=7)
    ap.add_argument("--no-restart", action="store_true")
    a = ap.parse_args()
    if a.keep < 1:
        ap.error("--keep must be positive")
    if os.geteuid() != 0:
        sys.exit("backup: run as root")
    cfg = oolib.load()
    dest = Path(a.dest or cfg.state / "backups")
    dest.mkdir(parents=True, exist_ok=True)
    os.chmod(dest, 0o700)
    cfg.run.mkdir(parents=True, exist_ok=True)
    with open(cfg.run / "backup.lock", "w") as lockf:
        try:
            fcntl.flock(lockf, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            sys.exit("backup: another backup is running")

        stamp = time.strftime("%Y%m%dT%H%M%SZ", time.gmtime())
        out = dest / f"{stamp}.partial"
        prevs = sorted(p for p in dest.glob("*/manifest.json"))
        prev = prevs[-1].parent if prevs else None
        need = sum(du(cfg.state / d) for d in ("engine", "store")) if prev is None else sum(du(cfg.state / d) for d in ("engine", "store")) // 4
        free = shutil.disk_usage(dest).free
        if free < need + (4 << 30):
            sys.exit(f"backup: not enough free space on {dest} ({free >> 20} MiB free, need about {(need + (4 << 30)) >> 20} MiB)")

        out.mkdir(mode=0o700)
        copy_state(cfg, out, prev, fenced=False)
        app_services = [app.service for app in cfg.orange_apps()]
        priority = [service for service in app_services if service == "oo-app.stats"]
        # Host agents spool for four minutes; reopen Stats before waiting for unrelated apps.
        services = ["oo-dns", "oo-store", "oo-engine", "oo-identity", *priority, "oo-ingress",
                    *(service for service in app_services if service not in priority), "oo-tunnel"]
        was = {service: running(service) for service in services}
        t0 = time.time()
        print("fencing: draining stack (ingress -> apps -> identity -> engine -> store)")
        err = None
        def interrupted(signum, frame):
            raise InterruptedError(f"signal {signum}")
        for sig in (signal.SIGTERM, signal.SIGINT):
            signal.signal(sig, interrupted)
        try:
            run(str(HERE / "drain"))
            copy_state(cfg, out, prev, fenced=True)
            run("rsync", "-a", "--numeric-ids", f"{cfg.etc}/", f"{out / 'etc'}/")
            for f in ("apps.toml", "images.lock.json"):
                shutil.copy2(HERE.parent / f, out / f)
        except BaseException as e:  # noqa: BLE001 -- always restart the stack
            err = e
        if not a.no_restart or err:
            print("restarting previously running services")
            def defer_signal(signum, frame):
                print(f"signal {signum} received while restarting", file=sys.stderr)
            for sig in (signal.SIGTERM, signal.SIGINT):
                signal.signal(sig, defer_signal)
            for svc, was_up in was.items():
                if was_up and not running(svc):
                    result = subprocess.run(["rc-service", svc, "start"], text=True)
                    if result.returncode:
                        print(f"restart failed: {svc}", file=sys.stderr)
                        err = err or RuntimeError(f"restart failed: {svc}")
        down = time.time() - t0
        if err:
            print(f"backup FAILED: {err}; partial copy left at {out}", file=sys.stderr)
            sys.exit(1)

        print("checksumming the copy (stack is back up)")
        sums = out / "SHA256SUMS"
        with open(sums, "w") as f:
            subprocess.run("find engine store etc apps.toml images.lock.json -type f -print0 | LC_ALL=C sort -z | xargs -0 sha256sum", shell=True, cwd=out, stdout=f, check=True)
        nfiles = sum(1 for _ in open(sums))
        manifest = {
            "timestamp_utc": stamp,
            "consistency": "fenced: all services stopped (drain order) while copying",
            "downtime_seconds": round(down, 1),
            "files": nfiles,
            "bytes": du(out),
            "link_dest": prev.name if prev else None,
            "services_running_before": [s for s, u in was.items() if u],
            "images": oolib.lock()["images"],
            "apps": {n: {"namespace": x.namespace, "buckets": list(x.buckets)} for n, x in ((x.name, x) for x in cfg.orange_apps())},
            "loss_model": "single host, single disk unless --dest is another device; engine writes acknowledged after the fence are not in this copy",
        }
        (out / "manifest.json").write_text(json.dumps(manifest, indent=2) + "\n")
        final = dest / stamp
        out.rename(final)
        print(f"backup ok: {final} ({nfiles} files, downtime {down:.0f}s)")
        done = sorted(p.parent for p in dest.glob("*/manifest.json"))
        for old in done[: max(0, len(done) - a.keep)]:
            shutil.rmtree(old)
            print(f"pruned {old.name}")


if __name__ == "__main__":
    main()
