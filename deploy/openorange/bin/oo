#!/usr/bin/env python3
"""OpenOrange host stack control: validation, rendering, provisioning.

    oo validate                 check apps.toml (+ /etc/openorange/overlay.toml)
    oo images                   print pinned image references
    oo apps-list [--all]        enabled Orange apps that have an image (--all: even without)
    oo run-args SERVICE [APP]   docker run argument vector (used by OpenRC units)
    oo secrets                  create missing secrets/env files (root-only, never printed)
    oo prepare SERVICE [APP]    create directories and ownership a unit needs
    oo render [--stdout [--tls internal|acme]]   write engine config, Caddyfile, ingress env, conf.d
    oo network                  ensure the private docker network
    oo provision [APP...]       store users/buckets, Rivet namespaces/pools
    oo set-image APP IMAGE [--if-current IMAGE]  conditionally select an image
    oo deployment APP           read the selected image and node version as JSON
    oo record-deployment APP --if-current IMAGE  record a healthy activation
    oo sync-deployments [APP]   retry queued deployment markers
    oo remove APP [--purge-store]  stop and unregister an app (optionally delete its buckets and S3 key)
    oo reload-ingress           validate and gracefully reload Caddy
    oo wait SERVICE [APP] [SECS]  block until a service answers

Must run as root for anything that touches /etc/openorange.
"""
from __future__ import annotations

import json
import hashlib
import secrets
import tempfile
import os
import re
import shlex
import socket
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
import xml.etree.ElementTree as ET
from pathlib import Path

sys.path.insert(0, str(Path(os.path.realpath(__file__)).parent.parent / "lib"))
import oolib  # noqa: E402
import deployments  # noqa: E402
from oo_s3 import S3  # noqa: E402
from oolib import UID, ConfigError  # noqa: E402

SERVICES = ("store", "engine", "identity", "ingress", "tunnel", "dns", "rivet", "platform", "app")


def die(msg: str, code: int = 1):
    print(f"oo: {msg}", file=sys.stderr)
    sys.exit(code)


def chown_dir(path: Path, mode: int, uid: int | None = int(UID)) -> None:
    path.mkdir(parents=True, exist_ok=True)
    os.chmod(path, mode)
    if uid is not None:
        os.chown(path, uid, uid)


# ------------------------------------------------------------------ secrets
def replace_platform_file(path: Path, text: str) -> None:
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    path.parent.chmod(0o700)
    fd, temporary = tempfile.mkstemp(dir=path.parent, prefix=".platform-")
    try:
        with os.fdopen(fd, "w") as out:
            out.write(text)
            out.flush()
            os.fsync(out.fileno())
        os.chown(temporary, 0, int(UID))
        os.chmod(temporary, 0o440)
        os.replace(temporary, path)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def cmd_configure_platform(cfg, actors) -> None:
    bridge = cfg.platform_bridge
    if bridge is None or not isinstance(actors, list) or len(actors) != 2:
        raise ConfigError("platform bridge requires two explicit Stats actor selectors")
    roles = set()
    for actor in actors:
        if not isinstance(actor, dict) or set(actor) != {"role", "name", "key"}:
            raise ConfigError("invalid platform actor selector")
        prefix = {"installation": "installation-", "observation": "observation-store-"}.get(actor["role"])
        if prefix is None or not isinstance(actor["name"], str) or not re.fullmatch(prefix + r"[a-f0-9]{8}", actor["name"]) or not isinstance(actor["key"], str) or not re.fullmatch(r"[a-f0-9]{64}", actor["key"]):
            raise ConfigError("invalid platform actor selector")
        roles.add(actor["role"])
    if roles != {"installation", "observation"}:
        raise ConfigError("both Stats actor roles are required")
    policy = {"resourceService": bridge.resource_service, "openorangeVersion": bridge.openorange_version,
              "rivetkitVersion": bridge.rivetkit_version, "nativeVersion": bridge.native_version,
              "samplePpm": bridge.sample_ppm, "actors": actors}
    replace_platform_file(cfg.etc / "platform/policy.json", json.dumps(policy) + "\n")


def cmd_discover_platform(cfg) -> None:
    bridge = cfg.platform_bridge
    if bridge is None or bridge.openorange_version != "1.0.2":
        raise ConfigError("platform selector discovery requires pinned OpenOrange 1.0.2")
    script = r'''import fs from "node:fs";
import { createHash } from "node:crypto";
import { pathToFileURL } from "node:url";
const base = "/orange/node_modules/open-orange";
if (JSON.parse(fs.readFileSync(base + "/package.json", "utf8")).version !== "1.0.2") throw new Error("unsupported OpenOrange selector version");
const chunks = fs.readdirSync(base + "/dist/runtime/chunks").filter(name => name.endsWith(".js") && fs.readFileSync(base + "/dist/runtime/chunks/" + name, "utf8").includes("function createDurableObjectIdScope("));
if (chunks.length !== 1) throw new Error("ambiguous pinned selector implementation");
const helpers = await import(pathToFileURL(base + "/dist/runtime/chunks/" + chunks[0]).href);
const actors = [];
for (const [role, file, worker, className, objectName] of [["installation", "stats", "stats", "Installation", "installation"], ["observation", "observe", "stats-observe", "ObservationStore", "stats"]]) {
 if (JSON.parse(fs.readFileSync("/app/" + file + ".jsonc", "utf8")).name !== worker) throw new Error("unexpected Stats worker descriptor");
 const deployment = createHash("sha256").update("open-orange-deployment\0").update("\0").update(worker).update("\0").digest("hex");
 const hash = createHash("sha256").update("open-orange-durable-object\0").update(deployment).update("\0").update(className).digest("hex").slice(0, 8);
 const name = (role === "installation" ? "installation-" : "observation-store-") + hash;
 const key = helpers.createDurableObjectIdScope({ namespaceKey: helpers.durableObjectNamespaceKey(deployment, className) }).idFromName(objectName).toString();
 actors.push({ role, name, key });
}
console.log(JSON.stringify(actors));'''
    result = oolib.docker("exec", "-i", cfg.apps[bridge.source_app].container, "node", "--input-type=module", input=script, check=False)
    if result.returncode != 0:
        raise ConfigError("cannot derive selectors from the pinned Stats image")
    actors = json.loads(result.stdout)
    namespace = urllib.parse.quote(cfg.apps[bridge.source_app].namespace, safe="")
    for actor in actors:
        status, payload = engine_call(cfg, "GET", f"/actors?namespace={namespace}&name={urllib.parse.quote(actor['name'], safe='')}&limit=100")
        if status != 200 or not isinstance(payload, dict):
            raise ConfigError("cannot verify production actor selectors")
        matches = [row for row in payload.get("actors", []) if row.get("name") == actor["name"] and row.get("key") == actor["key"] and row.get("destroy_ts") is None]
        if len(matches) != 1:
            raise ConfigError("selector must match exactly one live Stats actor")
    cmd_configure_platform(cfg, actors)
    print("platform: two live Stats actor selectors verified and stored")


def cmd_secrets(cfg) -> None:
    etc = cfg.etc
    etc.mkdir(parents=True, exist_ok=True)
    os.chmod(etc, 0o700)
    (etc / "apps").mkdir(exist_ok=True)
    os.chmod(etc / "apps", 0o700)

    store = oolib.read_env(cfg.store_env)
    store.setdefault("ROOT_ACCESS_KEY", "OOROOT" + oolib.token(8).upper())
    store.setdefault("ROOT_SECRET_KEY", oolib.token(20))
    oolib.write_env(cfg.store_env, store, "versitygw root credentials (root-only)")

    engine = oolib.read_env(cfg.engine_env)
    engine.setdefault("RIVET__AUTH__ADMIN_TOKEN", oolib.token(32))
    oolib.write_env(cfg.engine_env, engine, "Rivet Engine admin token (root-only)")

    if cfg.rivet is not None:
        directory = etc / "rivet"
        directory.mkdir(exist_ok=True)
        directory.chmod(0o700)
        file = directory / "config.json"
        previous = json.loads(file.read_text()) if file.exists() else {}
        settings = {"engine_origin": cfg.engine_url, "engine_token": engine["RIVET__AUTH__ADMIN_TOKEN"],
                    "gateway_secret": previous.get("gateway_secret") or oolib.token(32), "operators": list(cfg.rivet.operators)}
        temporary = file.with_suffix(".pending")
        fd = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w") as out:
            json.dump(settings, out)
            out.write("\n")
            out.flush()
            os.fsync(out.fileno())
        os.chown(temporary, 0, int(UID))
        temporary.chmod(0o440)
        os.replace(temporary, file)

    platform_env = {}
    if cfg.platform_bridge is not None:
        bridge = cfg.platform_bridge
        platform_env = oolib.read_env(etc / "platform.env")
        platform_env.setdefault("PLATFORM_OTLP_TOKEN", secrets.token_urlsafe(32))
        platform_env.setdefault("STATS_INGEST_TOKEN", "nft_" + secrets.token_urlsafe(32))
        stats = cfg.apps[bridge.source_app]
        platform_env.update(STATS_ORIGIN=f"http://{stats.ip}:{stats.port}", PLATFORM_POLICY_FILE="/run/secrets/platform-policy.json", PLATFORM_HOST="0.0.0.0", PLATFORM_PORT=str(bridge.port))
        oolib.write_env(etc / "platform.env", platform_env)

    for app in cfg.apps.values():
        path = cfg.app_env(app)
        cur = oolib.read_env(path)
        env: dict[str, str] = {"GATEWAY_SECRET": cur.get("GATEWAY_SECRET") or oolib.token(32)}
        if app.kind == "orange":
            env.update(
                RIVET_ENDPOINT=cfg.engine_url,
                RIVET_NAMESPACE=app.namespace,
                RIVET_TOKEN=engine["RIVET__AUTH__ADMIN_TOKEN"],
                S3_ENDPOINT=cfg.store_url,
                S3_REGION=cfg.store["region"],
                S3_ACCESS_KEY_ID=cur.get("S3_ACCESS_KEY_ID") or "OOAPP" + oolib.token(8).upper(),
                S3_SECRET_ACCESS_KEY=cur.get("S3_SECRET_ACCESS_KEY") or oolib.token(20),
                S3_BUCKETS=",".join(app.buckets),
                # open-orange builds Worker secret bindings from the environment variables named here.
                ORANGE_WORKER_SECRETS=",".join(["GATEWAY_SECRET", *app.secrets, *app.vars, *(["S3_ENDPOINT", "S3_REGION", "S3_ACCESS_KEY_ID", "S3_SECRET_ACCESS_KEY"] if app.worker_s3 else [])]),
            )
            env.update(app.vars)
            if cfg.platform_bridge is not None and app.name == cfg.platform_bridge.source_app:
                bridge = cfg.platform_bridge
                env.update(PLATFORM_BRIDGE_TOKEN_SHA256=hashlib.sha256(platform_env["STATS_INGEST_TOKEN"].encode()).hexdigest(),
                           OTEL_SERVICE_NAME=bridge.resource_service,
                           OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=f"http://{bridge.ip}:{bridge.port}/v1/traces",
                           OTEL_EXPORTER_OTLP_TRACES_PROTOCOL="http/json",
                           OTEL_EXPORTER_OTLP_HEADERS="Authorization=Bearer " + platform_env["PLATFORM_OTLP_TOKEN"],
                           OTEL_TRACES_SAMPLER="parentbased_traceidratio", OTEL_TRACES_SAMPLER_ARG=str(bridge.sample_ppm / 1000000),
                           OTEL_BSP_MAX_QUEUE_SIZE="256", OTEL_BSP_MAX_EXPORT_BATCH_SIZE="64", OTEL_EXPORTER_OTLP_TRACES_TIMEOUT="1000")
                env["ORANGE_WORKER_SECRETS"] += ",PLATFORM_BRIDGE_TOKEN_SHA256"
            # Orange maps each R2 binding onto an S3 endpoint through these
            # variables (runtime-node r2/s3-backend); the bucket name is the
            # R2 `bucket_name` of the binding.
            for b in app.buckets:
                pre = "ORANGE_R2_" + "".join(c if c.isalnum() else "_" for c in b.upper()) + "_S3_"
                env.update({pre + "ENDPOINT": cfg.store_url, pre + "REGION": cfg.store["region"], pre + "BUCKET": b,
                            pre + "ACCESS_KEY_ID": env["S3_ACCESS_KEY_ID"], pre + "SECRET_ACCESS_KEY": env["S3_SECRET_ACCESS_KEY"]})
        oolib.write_env(path, env, f"{app.name}: runtime secrets and endpoints (root-only; derived values rewritten by `oo secrets`)")
    print("secrets: ok (values are never printed)")


# ------------------------------------------------------------------ render
CADDY_STRIP = ["Tailscale-*", "Stats-Gateway-Secret", "Rivet-Gateway-Secret", "Stats-Tailnet-Identity", "X-OO-Peer", "X-OO-Ingress", "X-Forwarded-*", "Forwarded", "X-Real-Ip"]


def require_local_writer(cfg, app: str) -> None:
    route = oolib.load_recovery_routes(cfg).get(app)
    if route is not None and route.writer:
        die(f"{app}: local writer fenced; recovery writer active at {route.upstream}")


def reader_proxy(app, route: oolib.RecoveryRoute | None) -> list[str]:
    if route is None or route.writer:
        return []
    lines = ["\t\t@recoveryRead {", f"\t\t\thost {' '.join(route.read_hosts)}", "\t\t\tmethod GET HEAD"]
    paths = dict.fromkeys((*app.public_deny_paths, *route.deny_paths))
    if paths:
        normalized = "|".join(re.escape(path.lstrip("/")) for path in paths)
        lines += [f"\t\t\tnot path_regexp (?i)^/+(?:\\.{{1,2}}/+)*(?:{normalized})(?:[/;]|$)"]
    lines += ["\t\t}", f"\t\treverse_proxy @recoveryRead {route.upstream} {{", "\t\t\theader_up X-Forwarded-Proto https"]
    if route.snapshot_at:
        lines += [f"\t\t\theader_down X-{app.name.title()}-Recovery-Snapshot {route.snapshot_at}"]
    return lines + ["\t\t}"]


def render_caddyfile(cfg, recovery: dict[str, oolib.RecoveryRoute] | None = None) -> str:
    recovery = oolib.load_recovery_routes(cfg) if recovery is None else recovery
    ing = cfg.ingress
    lines = [
        "# Generated by `oo render` from apps.toml. Do not edit.",
        "{",
        "\tadmin unix//run/caddy/admin.sock",
        "\tauto_https disable_redirects",
        "\tgrace_period 15s",
        "\tskip_install_trust",
        "\tlog {",
        "\t\toutput stdout",
        "\t\tformat console",
        "\t}",
        "}",
        "",
    ]
    tls = "tls internal" if ing["tls"] == "internal" else "tls {\n\t\tdns cloudflare {env.CF_API_TOKEN}\n\t}"
    for app in cfg.enabled_apps():
        addrs = ", ".join(app.hostnames)
        lines += [f"# {app.display} ({app.kind})", f"{addrs} {{", f"\tbind {ing['bind']}", f"\t{tls}"]
        lines += ["\tlog {", "\t\toutput stdout", "\t\tformat filter {", "\t\t\twrap console",
                  "\t\t\tfields {", "\t\t\t\trequest>headers delete", "\t\t\t\tresp_headers delete", "\t\t\t}", "\t\t}", "\t}"]
        lines += ["\troute {"]
        lines += ["\t\t@unverifiedPeer not remote_ip 0.0.0.0/0 ::/0", "\t\trespond @unverifiedPeer 403"]
        lines += [f"\t\trequest_header -{h}" for h in CADDY_STRIP]
        lines += ["\t\trequest_header X-OO-Ingress tailnet"]
        lines += [
            "\t\tforward_auth unix//run/identity/identity.sock {",
            "\t\t\turi /auth",
            "\t\t\theader_up X-OO-Peer {http.request.remote}",
            "\t\t\tcopy_headers Stats-Tailnet-Identity",
            "\t\t}",
        ]
        dashboard = cfg.rivet
        if dashboard is not None and dashboard.hostname in app.hostnames:
            lines += ["\t\t@rivet {", f"\t\t\thost {dashboard.hostname}",
                      f"\t\t\tpath {oolib.RIVET_PATH} {oolib.RIVET_PATH}/*", "\t\t}",
                      "\t\thandle @rivet {", f"\t\t\treverse_proxy {dashboard.ip}:{dashboard.port} {{",
                      "\t\t\t\theader_up Rivet-Gateway-Secret {$GW_SECRET_RIVET}", "\t\t\t}", "\t\t}"]
        route = recovery.get(app.name)
        writer = route is not None and route.writer
        lines += reader_proxy(app, route)
        if app.kind == "orange" and not writer and not cfg.app_image_file(app).exists():
            lines += ['\t\trespond "app not deployed" 503']
        else:
            upstream = app.upstream if app.kind == "native" else f"{app.ip}:{app.port}"
            key = app.env_key
            if writer:
                upstream = route.upstream
                key = f"RECOVERY_{key}"
            lines += [
                f"\t\treverse_proxy {upstream} {{",
                f"\t\t\theader_up Stats-Gateway-Secret {{$GW_SECRET_{key}}}",
                "\t\t}",
            ]
        lines += ["\t}", "}", ""]
    pub = cfg.public
    pub_apps = [a for a in cfg.enabled_apps() if a.public_hostnames]
    if pub and pub_apps:
        port = pub["port"]
        lines += [
            "# Public listener: plain HTTP on loopback only, reached by the outbound cloudflared tunnel.",
            "# No identity sidecar and no gateway secret: the app sees `X-OO-Ingress: public` and nothing else.",
        ]
        for app in pub_apps:
            addrs = ", ".join(f"http://{h}:{port}" for h in app.public_hostnames)
            lines += [f"# {app.display} (public)", f"{addrs} {{", f"\tbind {pub['bind']}", "\troute {"]
            lines += [f"\t\trequest_header -{h}" for h in CADDY_STRIP]
            lines += ["\t\trequest_header X-OO-Ingress public"]
            for i, path in enumerate(app.public_deny_paths):
                lines += [f"\t\t@deny{i} path {path} {path}/*",
                          f"\t\trespond @deny{i} 404",
                          # Tolerate dot segments, repeated slashes and `;params` the app might normalise away.
                          f"\t\t@denyre{i} path_regexp (?i)^/+(?:\\.{{1,2}}/+)*{path.lstrip('/')}(?:[/;]|$)",
                          f"\t\trespond @denyre{i} 404"]
            if app.public_methods:
                lines += [f"\t\t@private_method not method {' '.join(app.public_methods)}",
                          f"\t\theader @private_method Allow \"{', '.join(app.public_methods)}\"",
                          "\t\trespond @private_method 405"]
            lines += reader_proxy(app, recovery.get(app.name))
            if app.kind == "orange" and not cfg.app_image_file(app).exists():
                lines += ['\t\trespond "app not deployed" 503']
            else:
                lines += [f"\t\treverse_proxy {app.ip}:{app.port} {{",
                          "\t\t\theader_up X-Forwarded-Proto https", "\t\t}"]
            lines += ["\t}", "}", ""]
        lines += [f"# Any other Host on the public listener", f"http://:{port} {{", f"\tbind {pub['bind']}", '\trespond "not found" 404', "}", ""]
    return "\n".join(lines)


def cmd_render(cfg, stdout: bool = False) -> None:
    recovery = oolib.load_recovery_routes(cfg)
    caddyfile = render_caddyfile(cfg, recovery)
    if stdout:
        print(caddyfile, end="")
        return
    env = {}
    if cfg.rivet is not None:
        file = cfg.etc / "rivet/config.json"
        if not file.exists():
            die("Rivet dashboard configuration missing; run `oo secrets`")
        env["GW_SECRET_RIVET"] = json.loads(file.read_text())["gateway_secret"]
    for app in cfg.enabled_apps():
        route = recovery.get(app.name)
        writer = route is not None and route.writer
        file = cfg.etc / "apps" / f"{app.name}.recovery.env" if writer else cfg.app_env(app)
        sec = oolib.read_env(file).get("GATEWAY_SECRET")
        if not sec:
            die(f"missing gateway secret in {file}")
        key = f"RECOVERY_{app.env_key}" if writer else app.env_key
        env[f"GW_SECRET_{key}"] = sec
    if cfg.dns.get("enabled"):
        dns = cfg.etc / "dns"
        dns.mkdir(parents=True, exist_ok=True)
        (dns / "Corefile").write_text(oolib.dns_config(cfg))
        (dns / "Corefile").chmod(0o644)
    # engine config
    ecfg = {
        "storage": {"log_directory": "/var/lib/rivet/log", "auto_provision_partitions": 1, "balancing": {"enabled": False}},
        "object_storage": {"primary": {"file_system": {"path": "/var/lib/rivet/objects"}}},
        "telemetry": {"enabled": False},
    }
    d = cfg.etc / "engine"
    d.mkdir(parents=True, exist_ok=True)
    (d / "config.json").write_text(json.dumps(ecfg, indent=2) + "\n")
    os.chmod(d / "config.json", 0o644)
    os.chmod(d, 0o755)
    # ingress
    d = cfg.etc / "ingress"
    d.mkdir(parents=True, exist_ok=True)
    os.chmod(d, 0o755)
    (d / "Caddyfile").write_text(caddyfile)
    os.chmod(d / "Caddyfile", 0o644)
    oolib.write_env(cfg.etc / "ingress.env", env, "per-app gateway secrets for Caddy (derived; root-only)")
    # OpenRC ordering: ingress starts after, and therefore stops before, every app.
    conf = Path("/etc/conf.d/oo-ingress")
    after = " ".join(a.service for a in cfg.orange_apps())
    conf.write_text(f'# Generated by `oo render`.\nrc_after="{after}"\n')
    print(f"render: ok (tls={cfg.ingress['tls']}, {len(cfg.enabled_apps())} apps, {sum(len(a.hostnames) for a in cfg.enabled_apps())} hostnames)")


# ------------------------------------------------------------------ prepare
TAILNET_ADDRESS_WAIT = 120


def address_assigned(address: str) -> bool:
    with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as probe:
        try:
            probe.bind((address, 0))
        except OSError:
            return False
    return True


def wait_for_address(address: str, timeout: float, assigned=address_assigned,
                     sleep=time.sleep, clock=time.monotonic) -> bool:
    """At boot, tailscaled assigns the tailnet address after OpenRC may already start its listeners."""
    deadline = clock() + timeout
    while not assigned(address):
        if clock() >= deadline:
            return False
        sleep(1)
    return True


def require_tailnet_address(cfg) -> None:
    address = cfg.ingress["bind"]
    if not wait_for_address(address, TAILNET_ADDRESS_WAIT):
        die(f"tailnet address {address} is not assigned after {TAILNET_ADDRESS_WAIT}s; check `tailscale status`")


def cmd_prepare(cfg, service: str, app: str | None) -> None:
    u = int(UID)
    if service == "store":
        for d in ("data", "versions", "iam"):
            chown_dir(cfg.state / "store" / d, 0o700)
        chown_dir(cfg.run / "store-admin", 0o700)
        for f in (cfg.store_env,):
            if not f.exists():
                die(f"{f} missing: run `oo secrets`")
        sock = cfg.run / "store-admin" / "admin.sock"
        if sock.exists():
            sock.unlink()
    elif service == "engine":
        for d in ("log", "objects"):
            chown_dir(cfg.state / "engine" / d, 0o700)
        if not cfg.engine_env.exists() or not (cfg.etc / "engine" / "config.json").exists():
            die("engine env/config missing: run `oo secrets && oo render`")
    elif service == "dns":
        if not cfg.dns.get("enabled") or not (cfg.etc / "dns/Corefile").exists():
            die("split DNS configuration missing")
        require_tailnet_address(cfg)
    elif service == "tunnel":
        if not cfg.tunnel.get("enabled") or not (cfg.etc / "tunnel.env").exists():
            die("tunnel configuration or root-owned tunnel.env missing")
    elif service == "identity":
        chown_dir(cfg.run / "identity", 0o700)
        sock = cfg.run / "identity" / "identity.sock"
        if sock.exists():
            sock.unlink()
    elif service == "platform":
        if cfg.platform_bridge is None or not all((cfg.etc / p).is_file() for p in ("platform.env", "platform.image", "platform/policy.json")):
            die("platform bridge disabled or image, policy, or secrets missing")
        oolib.run_args(cfg, "platform")
    elif service == "rivet":
        if cfg.rivet is None or not (cfg.etc / "rivet/config.json").is_file() or not (cfg.etc / "rivet.image").is_file():
            die("Rivet dashboard configuration/image missing: run `oo secrets && bin/build-rivet`")
    elif service == "ingress":
        for d in ("data", "config"):
            chown_dir(cfg.state / "caddy" / d, 0o700)
        chown_dir(cfg.run / "caddy", 0o700)
        cmd_render(cfg)
        require_tailnet_address(cfg)
    elif service == "app":
        if not app or app not in cfg.apps or cfg.apps[app].kind != "orange":
            die(f"unknown orange app {app!r}")
        require_local_writer(cfg, app)
        if not cfg.app_env(cfg.apps[app]).exists():
            die(f"{cfg.app_env(cfg.apps[app])} missing: run `oo secrets`")
    else:
        die(f"unknown service {service}")
    cfg.logs.mkdir(parents=True, exist_ok=True)
    os.chmod(cfg.logs, 0o750)
    cfg.run.mkdir(parents=True, exist_ok=True)
    os.chmod(cfg.run, 0o755)
    oolib.reserve_slice(cfg.state)
    _ = u


# ------------------------------------------------------------------ network
def cmd_network(cfg) -> None:
    n = cfg.network
    r = oolib.docker("network", "inspect", n["name"], check=False)
    if r.returncode == 0:
        info = json.loads(r.stdout)[0]
        subs = [c["Subnet"] for c in info["IPAM"]["Config"]]
        if n["subnet"] not in subs or bool(info["Internal"]) != n["internal"]:
            die(f"network {n['name']} exists with subnet {subs}, internal={info['Internal']}: refusing to change")
        print(f"network: {n['name']} ok")
    else:
        args = ["network", "create", "--driver", "bridge", "--subnet", n["subnet"],
                "--opt", f"com.docker.network.bridge.name={n['bridge']}"]
        if n["internal"]:
            args.append("--internal")
        oolib.docker(*args, n["name"])
        print(f"network: created {n['name']} {n['subnet']} internal={n['internal']}")
    if any(app.internet for app in cfg.orange_apps()):
        result = oolib.docker("network", "inspect", cfg.egress_network, check=False)
        if result.returncode == 0:
            info = json.loads(result.stdout)[0]
            if info["Internal"] or info["Driver"] != "bridge":
                die(f"network {cfg.egress_network} must be a non-internal bridge")
        else:
            oolib.docker("network", "create", "--driver", "bridge", cfg.egress_network)
        print(f"network: {cfg.egress_network} ok")


# ------------------------------------------------------------------ provision
def store_admin(cfg) -> S3:
    env = oolib.read_env(cfg.store_env)
    sock = cfg.run / "store-admin" / "admin.sock"
    if not sock.exists():
        die("store admin socket missing: is oo-store running?")
    return S3(f"unix:{sock}", cfg.store["region"], env["ROOT_ACCESS_KEY"], env["ROOT_SECRET_KEY"], timeout=15)


def store_s3(cfg) -> S3:
    env = oolib.read_env(cfg.store_env)
    return S3(cfg.store_url, cfg.store["region"], env["ROOT_ACCESS_KEY"], env["ROOT_SECRET_KEY"], timeout=15)


def provision_store(cfg, apps) -> None:
    adm = store_admin(cfg)
    st, _, body = adm.request("PATCH", "/list-users")
    if st != 200:
        die(f"store list-users -> {st}")
    existing = {e.text for e in ET.fromstring(body).iter("Access")}
    st, _, body = store_s3(cfg).request("GET", "/")
    if st != 200:
        die(f"store list-buckets -> {st}")
    buckets = {e.text for e in ET.fromstring(body).iter() if e.tag.endswith("Name") and e.text}
    for app in apps:
        env = oolib.read_env(cfg.app_env(app))
        ak, sk = env["S3_ACCESS_KEY_ID"], env["S3_SECRET_ACCESS_KEY"]
        if ak not in existing:
            xml = (f"<Account><Access>{ak}</Access><Secret>{sk}</Secret><Role>user</Role><UserID>0</UserID>"
                   "<GroupID>0</GroupID><ProjectID>0</ProjectID><RoleArn></RoleArn></Account>").encode()
            st, _, b = adm.request("PATCH", "/create-user", body=xml)
            if st not in (200, 201):
                die(f"store create-user for {app.name} -> {st}")
            print(f"store: created user for {app.name}")
        for b in app.buckets:
            if b not in buckets:
                st, _, body = adm.request("PATCH", f"/{b}/create", headers={"x-vgw-owner": ak})
                if st not in (200, 201):
                    die(f"store create bucket {b} -> {st}")
                print(f"store: created bucket {b} (owner {app.s3_user})")
            else:
                st, _, _ = adm.request("PATCH", "/change-bucket-owner/", query={"bucket": b, "owner": ak})
                if st != 200:
                    die(f"store change-bucket-owner {b} -> {st}")
            if app.versioning:
                client = store_s3(cfg)
                st, _, _ = client.request("PUT", f"/{b}", query={"versioning": ""}, body=b'<VersioningConfiguration xmlns="http://s3.amazonaws.com/doc/2006-03-01/"><Status>Enabled</Status></VersioningConfiguration>')
                if st != 200:
                    die(f"store enable versioning {b} -> {st}")
                st, _, body = client.request("GET", f"/{b}", query={"versioning": ""})
                if st != 200 or not any(e.tag.endswith("Status") and e.text == "Enabled" for e in ET.fromstring(body).iter()):
                    die(f"store versioning verification failed for {b}")



def engine_call(cfg, method: str, path: str, body: dict | None = None):
    tok = oolib.read_env(cfg.engine_env)["RIVET__AUTH__ADMIN_TOKEN"]
    req = urllib.request.Request(cfg.engine_url + path, method=method, data=json.dumps(body).encode() if body is not None else None,
                                 headers={"Authorization": f"Bearer {tok}", "Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=15) as r:
            return r.status, json.loads(r.read() or b"null")
    except urllib.error.HTTPError as e:
        try:
            return e.code, json.loads(e.read())
        except ValueError:
            return e.code, None


def provision_engine(cfg, apps) -> None:
    st, doc = engine_call(cfg, "GET", "/namespaces")
    if st != 200:
        die(f"engine list namespaces -> {st}")
    have = {n["name"] for n in doc["namespaces"]}
    for app in apps:
        if app.namespace not in have:
            st, doc = engine_call(cfg, "POST", "/namespaces", {"name": app.namespace})
            if st != 200:
                die(f"engine create namespace {app.namespace} -> {st} {doc}")
            print(f"engine: created namespace {app.namespace}")
        for pool in oolib.ORANGE_POOLS:
            st, doc = engine_call(cfg, "PUT", f"/pools/{pool}?namespace={app.namespace}", {})
            if st != 200:
                die(f"engine create pool {app.namespace}/{pool} -> {st} {doc}")


def cmd_provision(cfg, names: list[str]) -> None:
    apps = [cfg.apps[n] for n in names] if names else cfg.orange_apps()
    for a in apps:
        if a.kind != "orange":
            die(f"{a.name} is a native app; nothing to provision")
    cmd_secrets(cfg)
    cmd_network(cfg)
    provision_store(cfg, apps)
    provision_engine(cfg, apps)
    print("provision: ok for " + ", ".join(a.name for a in apps))


def cmd_set_image(cfg, app: str, image: str, *, expected_image: str | None = None) -> None:
    a = cfg.apps.get(app)
    if not a or a.kind != "orange":
        die(f"unknown orange app {app}")
    require_local_writer(cfg, app)
    f = cfg.app_image_file(a)
    deployment = oolib.set_app_deployment(f, image.strip(), expected_image=expected_image)
    print(f"{app}: image -> {deployment.image}, node version {deployment.version} (previous kept in {f.with_suffix('.image.prev').name})")


# ------------------------------------------------------------------ remove
def cmd_remove(cfg, name: str, purge_store: bool) -> None:
    """Stop and unregister one app. Never touches another app's container.

    The Rivet namespace is left in place: Engine 3.1.x has no namespace delete
    endpoint, so a removed app's Durable Object state stays in the Engine
    volumes until the Engine storage itself is reset.
    """
    import subprocess

    app = cfg.apps.get(name)
    if not app or app.kind != "orange":
        die(f"unknown orange app {name}")
    svc = app.service
    subprocess.run(["rc-service", svc, "stop"], capture_output=True)
    subprocess.run(["rc-update", "del", svc, "default"], capture_output=True)
    link = Path("/etc/init.d") / svc
    if link.is_symlink():
        link.unlink()
    env = oolib.read_env(cfg.app_env(app))
    if purge_store and env.get("S3_ACCESS_KEY_ID"):
        s3 = store_s3(cfg)
        for b in app.buckets:
            tok = None
            while True:
                q = {"list-type": "2", **({"continuation-token": tok} if tok else {})}
                st, _, body = s3.request("GET", f"/{b}", query=q)
                if st != 200:
                    break
                root = ET.fromstring(body)
                for c in root.iter():
                    if c.tag.endswith("}Key") or c.tag == "Key":
                        s3.request("DELETE", f"/{b}/{c.text}")
                trunc = [c.text for c in root.iter() if c.tag.endswith("IsTruncated")]
                nxt = [c.text for c in root.iter() if c.tag.endswith("NextContinuationToken")]
                if trunc and trunc[0] == "true" and nxt:
                    tok = nxt[0]
                else:
                    break
            st, _, _ = s3.request("DELETE", f"/{b}")
            print(f"store: bucket {b} deleted (http {st})")
        st, _, _ = store_admin(cfg).request("PATCH", "/delete-user", query={"access": env["S3_ACCESS_KEY_ID"]})
        print(f"store: user for {name} deleted (http {st})")
    for f in (cfg.app_env(app), cfg.app_image_file(app), cfg.app_extra_env(app), cfg.app_image_file(app).with_suffix(".image.prev")):
        f.unlink(missing_ok=True)
    print(f"{name}: stopped and unregistered. Remove its [apps.{name}] table (or the overlay), then `oo reload-ingress`.")
    print(f"note: Rivet namespace `{app.namespace}` remains (no delete endpoint in Engine 3.1.x)")


# ------------------------------------------------------------------ ingress
def cmd_reload_ingress(cfg) -> None:
    cmd_render(cfg)
    base = ["exec", "--env-file", str(cfg.etc / "ingress.env"), "oo-ingress", "caddy"]
    v = oolib.docker(*base, "validate", "--config", "/etc/caddy/Caddyfile", "--adapter", "caddyfile", check=False)
    if v.returncode != 0:
        die(f"Caddyfile invalid, not reloading:\n{v.stderr[-800:]}")
    r = oolib.docker(*base, "reload", "--config", "/etc/caddy/Caddyfile", "--adapter", "caddyfile",
                     "--address", "unix//run/caddy/admin.sock", check=False)
    if r.returncode != 0:
        die(f"reload failed:\n{r.stderr[-800:]}")
    print("ingress: reloaded")


# ------------------------------------------------------------------ wait
def http_ok(url: str, headers=None, timeout=3, ok=lambda s: 200 <= s < 300) -> bool:
    req = urllib.request.Request(url, headers=headers or {})
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            return ok(r.status)
    except urllib.error.HTTPError as e:
        try:
            return ok(e.code)
        finally:
            e.close()
    except (OSError, ValueError):
        return False


def ready(cfg, service: str, app: str | None) -> bool:
    if service == "platform":
        bridge = cfg.platform_bridge
        if bridge is None or not all((cfg.etc / p).is_file() for p in ("platform.env", "platform.image", "platform/policy.json")):
            return False
        try:
            oolib.run_args(cfg, "platform")
            return http_ok(f"http://{bridge.ip}:{bridge.port}/health", ok=lambda status: status == 200)
        except (OSError, ConfigError):
            return False
    if service == "rivet":
        if cfg.rivet is None:
            return False
        settings = json.loads((cfg.etc / "rivet/config.json").read_text())
        headers = {"Rivet-Gateway-Secret": settings["gateway_secret"], "Stats-Tailnet-Identity": cfg.rivet.operators[0]}
        return http_ok(f"http://{cfg.rivet.ip}:{cfg.rivet.port}{oolib.RIVET_PATH}/api/health", headers=headers, ok=lambda status: status == 200)
    if service == "dns":
        if not cfg.dns.get("enabled"):
            return False
        hosts = sorted(oolib.dns_routes(cfg))
        name = b"".join(bytes([len(label)]) + label.encode("ascii") for label in hosts[0].split(".")) + b"\0"
        query = b"\x12\x34\x01\x00\x00\x01\x00\x00\x00\x00\x00\x00" + name + b"\x00\x01\x00\x01"
        with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as resolver:
            resolver.settimeout(2)
            try:
                resolver.sendto(query, (cfg.ingress["bind"], 53))
                packet, peer = resolver.recvfrom(4096)
                return (peer == (cfg.ingress["bind"], 53) and packet[:2] == query[:2]
                        and len(packet) >= 12 and packet[3] & 15 == 0 and packet[6:8] != b"\0\0"
                        and socket.inet_aton(cfg.ingress["bind"]) in packet[12:])
            except OSError:
                return False
    if service == "store":
        return http_ok(cfg.store_url + "/health")
    if service == "engine":
        return http_ok(cfg.engine_url + "/health")
    if service == "tunnel":
        return bool(cfg.tunnel.get("enabled")) and http_ok(f"http://127.0.0.1:{cfg.tunnel['metrics_port']}/ready")
    if service == "identity":
        s = socket.socket(socket.AF_UNIX)
        s.settimeout(2)
        try:
            s.connect(str(cfg.run / "identity" / "identity.sock"))
            return True
        except OSError:
            return False
        finally:
            s.close()
    if service == "ingress":
        try:
            with socket.create_connection((cfg.ingress["bind"], 443), timeout=2):
                return True
        except OSError:
            return False
    if service == "app":
        status, _ = oolib.app_readiness(cfg, cfg.apps[app])
        return status == 200
    return False


def cmd_wait(cfg, service: str, app: str | None, secs: float) -> None:
    deadline = time.time() + secs
    while time.time() < deadline:
        if ready(cfg, service, app):
            return
        time.sleep(1)
    die(f"{service}{'.' + app if app else ''} not ready after {secs:.0f}s", 2)


# ------------------------------------------------------------------ main
def main(argv: list[str]) -> None:
    if len(argv) < 2 or argv[1] in ("-h", "--help", "help"):
        print(__doc__)
        return
    cmd, rest = argv[1], argv[2:]
    try:
        cfg = oolib.load()
        if cmd == "validate":
            print(f"apps.toml ok: {len(cfg.apps)} apps ({', '.join(a.name + ('' if a.enabled else '[disabled]') for a in cfg.apps.values())}), tls={cfg.ingress['tls']}")
        elif cmd == "images":
            for k in oolib.lock()["images"]:
                print(f"{k:16} {oolib.image_ref(k)}")
            for k in oolib.lock()["local_builds"]:
                print(f"{k:16} {oolib.local_tag(k)} (built locally)")
        elif cmd == "run-args":
            service = rest[0]
            print(shlex.join(oolib.run_args(cfg, service, rest[1] if len(rest) > 1 else None)))
        elif cmd == "apps-list":
            allapps = rest[:1] == ["--all"]
            print("\n".join(a.name for a in cfg.orange_apps() if allapps or cfg.app_image_file(a).exists()))
        elif cmd == "tunnel-config":
            print(json.dumps(oolib.tunnel_config(cfg)))
        elif cmd == "tunnel-enabled":
            sys.exit(0 if cfg.tunnel.get("enabled") else 1)
        elif cmd == "dns-enabled":
            sys.exit(0 if cfg.dns.get("enabled") else 1)
        elif cmd == "platform-enabled":
            sys.exit(0 if cfg.platform_bridge is not None else 1)
        elif cmd == "set-platform-image":
            if len(rest) != 1 or not re.fullmatch(r"sha256:[0-9a-f]{64}", rest[0]):
                die("usage: oo set-platform-image sha256:IMAGE_ID")
            replace_platform_file(cfg.etc / "platform.image", rest[0] + "\n")
        elif cmd == "discover-platform":
            cmd_discover_platform(cfg)
        elif cmd == "configure-platform":
            if len(rest) != 1 or cfg.platform_bridge is None:
                die("usage: oo configure-platform ACTORS.json (bridge must be enabled)")
            cmd_configure_platform(cfg, json.loads(Path(rest[0]).read_text()))
        elif cmd == "rivet-enabled":
            sys.exit(0 if cfg.rivet is not None else 1)
        elif cmd == "set-rivet-image":
            if len(rest) != 1 or not re.fullmatch(r"sha256:[0-9a-f]{64}", rest[0]):
                die("usage: oo set-rivet-image sha256:IMAGE_ID")
            file = cfg.etc / "rivet.image"
            file.write_text(rest[0] + "\n")
            file.chmod(0o600)
        elif cmd == "dns-routes":
            print(json.dumps(oolib.dns_routes(cfg)))
        elif cmd == "secrets":
            cmd_secrets(cfg)
        elif cmd == "prepare":
            cmd_prepare(cfg, rest[0], rest[1] if len(rest) > 1 else None)
        elif cmd == "render":
            if "--tls" in rest:  # preview only: `oo render --tls acme --stdout`
                cfg.ingress["tls"] = rest[rest.index("--tls") + 1]
                if "--stdout" not in rest:
                    die("--tls overrides apps.toml only for a --stdout preview; edit [ingress].tls to change it")
            cmd_render(cfg, stdout="--stdout" in rest)
        elif cmd == "network":
            cmd_network(cfg)
        elif cmd == "provision":
            cmd_provision(cfg, rest)
        elif cmd == "set-image":
            if len(rest) not in (2, 4) or len(rest) == 4 and rest[2] != "--if-current":
                die("usage: oo set-image APP IMAGE [--if-current IMAGE]")
            cmd_set_image(cfg, rest[0], rest[1], expected_image=rest[3] if len(rest) == 4 else None)
        elif cmd == "deployment":
            name = rest[0]
            deployment = oolib.read_app_deployment(cfg.app_image_file(cfg.apps[name]))
            result = {"image": deployment.image, "version": deployment.version}
            route = oolib.load_recovery_routes(cfg).get(name)
            if route is not None and route.writer:
                result["recoveryWriter"] = route.upstream
            print(json.dumps(result))
        elif cmd == "record-deployment":
            if len(rest) != 3 or rest[1] != "--if-current":
                die("usage: oo record-deployment APP --if-current IMAGE")
            deployments.record(cfg, rest[0], rest[2], ready)
            print(f"{rest[0]}: deployment marker delivered")
        elif cmd == "sync-deployments":
            if len(rest) > 1:
                die("usage: oo sync-deployments [APP]")
            for name in rest or [a.name for a in cfg.orange_apps()]:
                deployments.sync(cfg, name)
            print("deployment markers: synced")
        elif cmd == "reload-ingress":
            cmd_reload_ingress(cfg)
        elif cmd == "remove":
            cmd_remove(cfg, rest[0], "--purge-store" in rest)
        elif cmd == "wait":
            svc = rest[0]
            app = rest[1] if svc == "app" else None
            secs = float(rest[2] if svc == "app" and len(rest) > 2 else rest[1] if svc != "app" and len(rest) > 1 else 60)
            cmd_wait(cfg, svc, app, secs)
        else:
            die(f"unknown command {cmd}")
    except ConfigError as e:
        die(str(e))
    except (IndexError, KeyError) as e:
        die(f"bad usage or missing config key: {e!r}")


if __name__ == "__main__":
    main(sys.argv)
