#!/bin/sh
set -eu
artifact=${1:?usage: build-platform-bridge /path/to/main.mjs}
[ -f "$artifact" ] || { echo 'platform: bundle not found' >&2; exit 1; }
HERE=$(cd "$(dirname "$0")/.." && pwd)
mkdir -p "$HERE/.work"
context=$(mktemp -d "$HERE/.work/platform-build.XXXXXX")
trap 'rm -rf "$context"' 0
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM
cp "$HERE/platform/Dockerfile" "$context/Dockerfile"
cp "$artifact" "$context/main.mjs"
docker build --platform linux/amd64 -t openorange/platform-bridge:local "$context"
image=$(docker image inspect --format '{{.Id}}' openorange/platform-bridge:local)
"$HERE/bin/oo" set-platform-image "$image"
echo "platform: built and pinned $image; restart oo-platform to activate"
