#!/usr/bin/env python3
import argparse
import base64
import hashlib
import json
import math
import os
import re
import sys
import time
import uuid
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / 'lib'))
import oorollout


def add_target(parser):
    parser.add_argument('--target-kind', required=True, choices=('fake', 'native', 'oo-containers'))
    parser.add_argument('--target', help='fake: local target directory')
    parser.add_argument('--host', help='ssh host alias')
    parser.add_argument('--app', help='oo-containers: OpenOrange app name')
    parser.add_argument('--ssh-config', help='ssh_config that resolves --host')


def target_config(args):
    if args.target_kind == 'fake':
        return {'target_kind': 'fake', 'target': str(Path(args.target).resolve())}
    return {'target_kind': args.target_kind, 'host': args.host, 'ssh_config': str(Path(args.ssh_config).expanduser()), **({'app': args.app} if args.target_kind == 'oo-containers' else {})}


def main():
    parser = argparse.ArgumentParser(description='Durable OpenOrange rollout controller. Target kinds: fake (a local directory, for tests) and native (the native standby Stats writer over ssh: runtime releases under /opt/native-rehearsal/runtime, activated by switching the /opt/native-rehearsal/orange symlink and restarting native-stats). oo-containers manages an OpenOrange app container over ssh.', epilog='Mutates the target release selection and running identity under a fenced deployment lock. Journals and controller heartbeats live outside the target in journal-dir/RUN_ID/journal.jsonl. Each transition has a deadline; an overdue post-prepare controller is recovered by watchdog. Qualification binds evidence release identities and artifact digest; preparation checks baseline identity, freshness, recovery artifact and headroom. Exit codes: 0 promoted, 3 rejected or recovered (not promoted), 4 lock held, 5 needs operator, 2 usage, 1 runtime error.')
    sub = parser.add_subparsers(dest='command', required=True)
    start = sub.add_parser('start', help='qualify and promote a release')
    for name in ('candidate', 'artifact', 'baseline', 'policy', 'receipt', 'evaluator', 'evidence-dir', 'journal-dir'):
        start.add_argument('--' + name, required=True)
    add_target(start)
    start.add_argument('--deadline-s', type=float, default=60)
    start.add_argument('--bound-s', type=float, default=10, help='maximum duration of each guest mutation in seconds (default: 10)')
    start.add_argument('--json', action='store_true')
    for command in ('status', 'resume', 'abort'):
        p = sub.add_parser(command, help=command + ' a run by its journal directory')
        p.add_argument('--run', required=True, help='path to journal-dir/RUN_ID')
    observe = sub.add_parser('observe', help='print the target identity; read-only')
    add_target(observe)
    observe.add_argument('--json', action='store_true')
    stage = sub.add_parser('stage', help='copy an installed runtime closure archive to a native target as a new release directory; never activates it')
    add_target(stage)
    stage.add_argument('--archive', required=True, help='local tar of package.json, pnpm-lock.yaml and node_modules')
    stage.add_argument('--source', required=True, help='provenance recorded in release.json, e.g. a build record digest')
    stage.add_argument('--bound-s', type=float, default=10, help='maximum guest staging duration in seconds (default: 10)')
    lease = sub.add_parser('lease', help='run a guest command under the shared lease')
    lease_sub = lease.add_subparsers(dest='lease_command', required=True)
    lease_run = lease_sub.add_parser('run', help='run a bounded native guest command', epilog='Example: rollout lease run --target-kind native --host stats --ssh-config FILE --operation restart --bound-s 60 -- rc-service native-stats restart')
    lease_run.add_argument('--target-kind', required=True, choices=('native',), help='native guest lease')
    lease_run.add_argument('--host', required=True, help='SSH host alias')
    lease_run.add_argument('--ssh-config', required=True, help='SSH configuration path')
    lease_run.add_argument('--operation', required=True, help='operation recorded in the lease')
    lease_run.add_argument('--bound-s', required=True, type=float, help='maximum command duration in seconds')
    lease_run.add_argument('argv', nargs=argparse.REMAINDER, help='-- followed by the guest command and arguments')
    watchdog = sub.add_parser('watchdog', help='recover runs with overdue heartbeats')
    watchdog.add_argument('--journal-dir', required=True, help='directory containing rollout journals')
    watchdog.add_argument('--loop', action='store_true', help='scan continuously and print JSON after each pass')
    watchdog.add_argument('--interval-s', type=float, default=10, help='seconds between passes (default: 10)')
    args = parser.parse_args()
    try:
        if args.command in ('start', 'observe', 'stage'):
            if args.target_kind == 'fake' and not args.target:
                parser.error('--target is required for the fake target kind')
            if args.target_kind in ('native', 'oo-containers') and not (args.host and args.ssh_config):
                parser.error('--host and --ssh-config are required for remote target kinds')
            if args.target_kind == 'oo-containers' and (not args.app or not re.fullmatch(r'[a-z][a-z0-9-]{0,31}', args.app)):
                parser.error('--app must be a valid OpenOrange app name')
        if args.command == 'lease':
            if not math.isfinite(args.bound_s) or args.bound_s <= 0 or not args.argv or args.argv[0] != '--' or len(args.argv) == 1:
                parser.error('lease run requires a positive bound and -- CMD')
            import oorollout_native
            adapter = oorollout_native.NativeAdapter(oorollout_native.ssh_runner(args.ssh_config, args.host))
            holder = 'lease-' + uuid.uuid4().hex
            token = adapter.acquire(holder, args.operation, args.bound_s + 5)
            try:
                token = adapter.renew(holder, token, args.bound_s + 5)
                result = adapter.call('run_command', holder=holder, token=token, bound_s=args.bound_s, argv=args.argv[1:])
                sys.stdout.buffer.write(base64.b64decode(result['stdout']))
                sys.stderr.buffer.write(base64.b64decode(result['stderr']))
                return result['returncode'] if result['returncode'] >= 0 else 128 - result['returncode']
            finally:
                try:
                    adapter.release(holder, token)
                except oorollout.StaleToken:
                    pass
        if args.command == 'observe':
            print(json.dumps(oorollout.adapter_for(target_config(args)).observe(), sort_keys=True))
            return 0
        if args.command == 'stage':
            if not math.isfinite(args.bound_s) or args.bound_s <= 0:
                parser.error('bound must be positive')
            if args.target_kind != 'native':
                parser.error('stage supports only the native target kind')
            import oorollout_native
            adapter = oorollout_native.NativeAdapter(oorollout_native.ssh_runner(args.ssh_config, args.host), bound_s=args.bound_s)
            holder = 'stage-' + uuid.uuid4().hex
            token = adapter.acquire(holder, 'stage', args.bound_s + 10)
            try:
                remote = '/var/lib/openorange-rollout/incoming-' + uuid.uuid4().hex + '.tar'
                archive_data = base64.b64encode(Path(args.archive).read_bytes()).decode('ascii')
                token = adapter.renew(holder, token, args.bound_s + 10)
                print(json.dumps(adapter.stage(holder, token, remote, args.source, archive_data=archive_data), sort_keys=True))
            finally:
                adapter.release(holder, token)
            return 0
        if args.command == 'start':
            if not math.isfinite(args.deadline_s) or args.deadline_s <= 0 or not math.isfinite(args.bound_s) or args.bound_s <= 0 or not re.fullmatch(r'sha256:[0-9a-f]{64}', args.artifact):
                parser.error('deadline must be positive and artifact must be a sha256 digest')
            root = Path(args.journal_dir).resolve()
            if args.target_kind == 'fake':
                target = Path(args.target).resolve()
                if root == target or root.is_relative_to(target):
                    parser.error('journal-dir must be outside target')
            policy_bytes = Path(args.policy).read_bytes()
            policy = json.loads(policy_bytes)
            for key in ('max_age_s', 'observation_s', 'check_interval_s'):
                if type(policy.get(key)) not in (int, float) or not math.isfinite(policy[key]) or policy[key] < 0 or (key != 'observation_s' and policy[key] == 0):
                    parser.error('invalid policy: ' + key)
            check = policy.get('functional_check')
            if not isinstance(check, dict) or not isinstance(check.get('argv'), list) or not check['argv'] or not all(isinstance(arg, str) for arg in check['argv']) or not check['argv'][0] or type(check.get('timeout_s')) not in (int, float) or not math.isfinite(check['timeout_s']) or check['timeout_s'] <= 0:
                parser.error('invalid policy: functional_check')
            directory = root / uuid.uuid4().hex
            run_id = str(directory)
            directory.mkdir(parents=True)
            oorollout.sync_dir(root)
            config = {**target_config(args), 'run_id': run_id, 'candidate': args.candidate, 'artifact': args.artifact, 'baseline': args.baseline, 'policy': policy, 'rollout_policy_sha256': hashlib.sha256(policy_bytes).hexdigest(), 'receipt': str(Path(args.receipt).resolve()), 'evaluator': str(Path(args.evaluator).resolve()), 'evidence_dir': os.path.abspath(args.evidence_dir), 'deadline_s': args.deadline_s, 'bound_s': args.bound_s}
            journal = oorollout.Journal(directory)
            journal.append('start', config=config)
            journal.transition('staged', args.deadline_s)
            print(json.dumps({'run_id': run_id, 'run': str(directory)}), flush=True)
            state = oorollout.run(journal)
        elif args.command == 'watchdog':
            if not math.isfinite(args.interval_s) or args.interval_s <= 0:
                parser.error('interval must be positive')
            while True:
                result = []
                for path in sorted(Path(args.journal_dir).iterdir()):
                    if not (path / 'journal.jsonl').exists():
                        continue
                    journal = oorollout.Journal(path)
                    heartbeat = journal.last('heartbeat')
                    if journal.state() in oorollout.POST_PREPARE and heartbeat and heartbeat['deadline'] < oorollout.now():
                        try:
                            result.append({'run': str(path), 'state': oorollout.run(journal, recovery=True, recovered_by='watchdog')})
                        except oorollout.LockHeld:
                            result.append({'run': str(path), 'state': 'lock-held'})
                        except (OSError, ValueError, KeyError, TypeError, oorollout.StaleToken) as exc:
                            result.append({'run': str(path), 'state': 'error', 'detail': str(exc)})
                print(json.dumps(result), flush=True)
                if not args.loop:
                    return 5 if any(x['state'] in ('needs-operator', 'error') for x in result) else 4 if any(x['state'] == 'lock-held' for x in result) else 3 if result else 0
                time.sleep(args.interval_s)
        else:
            journal = oorollout.Journal(args.run)
            if args.command == 'status':
                print(json.dumps(oorollout.status(journal)))
                return 0
            state = oorollout.run(journal, recovery=args.command == 'abort')
        print(json.dumps({'state': state}))
        return {'promoted': 0, 'rejected': 3, 'recovered': 3, 'needs-operator': 5}[state]
    except oorollout.LockHeld as exc:
        print('rollout: lock held by ' + str(exc), file=sys.stderr)
        return 4
    except (OSError, ValueError, KeyError, TypeError, oorollout.StaleToken) as exc:
        print('rollout: ' + str(exc), file=sys.stderr)
        return 1


if __name__ == '__main__':
    sys.exit(main())
