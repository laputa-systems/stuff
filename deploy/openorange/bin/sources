#!/usr/bin/env python3
import argparse
import hashlib
import json
import re
import sys
import tomllib
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
def verify(data, lock, root=ROOT):
    def fail(message):
        raise ValueError(message)

    if set(data) != {'schema', 'components'} or data['schema'] != 1 or not isinstance(data['components'], list):
        fail('registry: expected schema 1 and components')
    names, images, patches = set(), set(), []
    for item in data['components']:
        required = {'name', 'upstream', 'license', 'ownership', 'artifacts', 'patches', 'gaps'}
        allowed = required | {'revision', 'version', 'digest', 'image'}
        if not isinstance(item, dict) or not required <= item.keys() or item.keys() - allowed:
            fail('component: missing or unknown keys')
        name = item['name']
        if not isinstance(name, str) or not name or name in names:
            fail(f'component: invalid or duplicate name {name!r}')
        names.add(name)
        for key in ('upstream', 'license'):
            if not isinstance(item[key], str) or not item[key]:
                fail(f'{name}: invalid {key}')
        if item['ownership'] not in ('source-rebuilt', 'mirrored-unchanged', 'unrebuildable'):
            fail(f'{name}: invalid ownership')
        for key in ('artifacts', 'gaps'):
            if not isinstance(item[key], list) or any(not isinstance(x, str) or not x for x in item[key]):
                fail(f'{name}: invalid {key}')
        if not item['artifacts']:
            fail(f'{name}: artifacts must not be empty')
        if 'revision' in item:
            if not re.fullmatch(r'[0-9a-f]{40}', item['revision']) or 'version' in item or 'digest' in item:
                fail(f'{name}: invalid revision identity')
        elif not isinstance(item.get('version'), str) or not item['version'] or not re.fullmatch(r'(sha256:[0-9a-f]{64}|sha512-[A-Za-z0-9+/]+={0,2})', item.get('digest', '')):
            fail(f'{name}: invalid version or digest')
        if 'image' in item:
            image = item['image']
            if image in images or image not in lock['images']:
                fail(f'{name}: duplicate or unknown image {image}')
            images.add(image)
            expected = lock['images'][image]
            if item['ownership'] != 'mirrored-unchanged' or item.get('version') != expected['tag'] or item.get('digest') != expected['index_digest'] or item['upstream'] != 'https://' + expected['repository']:
                fail(f'{name}: image identity differs from images.lock.json')
        if not isinstance(item['patches'], list):
            fail(f'{name}: patches must be a list')
        for patch in item['patches']:
            if not isinstance(patch, dict) or set(patch) != {'file', 'sha256', 'purpose', 'affects', 'proof'} or any(not isinstance(v, str) or not v for v in patch.values()):
                fail(f'{name}: invalid patch fields')
            file = patch['file']
            if file in patches:
                fail(f'{name}: duplicate patch {file}')
            patches.append(file)
            path = root / 'patches' / file
            if not path.is_file():
                fail(f'{name}: missing patch {file}')
            if hashlib.sha256(path.read_bytes()).hexdigest() != patch['sha256']:
                fail(f'{name}: sha256 mismatch for {file}')
    unregistered = sorted(path.name for path in (root / 'patches').glob('*.patch') if path.name not in patches)
    if unregistered:
        fail(f'unregistered patches: {unregistered}')
    if images != set(lock['images']):
        fail(f'missing images: {sorted(set(lock["images"]) - images)}')


def main():
    parser = argparse.ArgumentParser(description='List or verify the offline OpenOrange source registry.')
    sub = parser.add_subparsers(dest='command', required=True)
    listing = sub.add_parser('list')
    listing.add_argument('--json', action='store_true', required=True)
    sub.add_parser('verify')
    args = parser.parse_args()
    try:
        data = tomllib.loads((ROOT / 'sources/sources.toml').read_text())
        verify(data, json.loads((ROOT / 'images.lock.json').read_text()))
        if args.command == 'list':
            print(json.dumps(data, indent=2))
        else:
            print('sources: verified')
    except (OSError, ValueError, KeyError, TypeError) as exc:
        print(f'sources: {exc}', file=sys.stderr)
        return 1
    return 0


if __name__ == '__main__':
    sys.exit(main())
