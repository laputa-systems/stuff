<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>xyz.17166969.openorange-rollout-watchdog</string>
  <key>ProgramArguments</key><array><string>@PYTHON@</string><string>@ROLLOUT@</string><string>watchdog</string><string>--journal-dir</string><string>@JOURNAL@</string><string>--loop</string><string>--interval-s</string><string>10</string></array>
  <key>StandardOutPath</key><string>@LOG@</string>
  <key>StandardErrorPath</key><string>@LOG@</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
</dict></plist>
