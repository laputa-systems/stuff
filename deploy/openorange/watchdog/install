#!/usr/bin/env python3
import argparse
import html
import os
import re
from pathlib import Path

parser = argparse.ArgumentParser(description='Render a supervised rollout watchdog service')
parser.add_argument('--kind', choices=('launchd', 'openrc'), required=True)
parser.add_argument('--journal-dir', required=True)
parser.add_argument('--rollout', required=True)
parser.add_argument('--output', required=True)
args = parser.parse_args()
for value in (args.journal_dir, args.rollout):
    if not os.path.isabs(value) or any(c in value for c in '\n\r\0'):
        parser.error('journal and rollout paths must be absolute and single-line')
if args.kind == 'openrc' and any(not re.fullmatch(r'/[A-Za-z0-9_./-]+', value) for value in (args.journal_dir, args.rollout)):
    parser.error('openrc paths must not contain shell metacharacters or whitespace')
template = Path(__file__).with_name('launchd.plist.in' if args.kind == 'launchd' else 'openrc.in').read_text()
values = (html.escape(args.rollout), html.escape(args.journal_dir)) if args.kind == 'launchd' else (args.rollout, args.journal_dir)
output = Path(args.output)
output.write_text(template.replace('@ROLLOUT@', values[0]).replace('@JOURNAL@', values[1]))
if args.kind == 'openrc':
    output.chmod(0o755)
