+#[cfg(test)]
+mod tests {
+	use super::*;
+
+	fn delay_ms(attempt: u32) -> u64 {
+		reconnect_delay(attempt, Some(100), 40_000).as_millis() as u64
+	}
+
+	#[test]
+	fn a_refusal_hint_is_the_floor_of_every_wait() {
+		for attempt in 0..8 {
+			assert!(delay_ms(attempt) >= 100, "attempt {attempt} drew below the hint");
+		}
+	}
+
+	#[test]
+	fn repeated_refusals_at_one_hint_stretch_the_wait() {
+		let ceiling = |attempt: u32| refusal_delay_bounds(attempt, 100).1;
+		assert_eq!(refusal_delay_bounds(0, 100), (100, 200));
+		assert_eq!(refusal_delay_bounds(1, 100), (100, 400));
+		assert_eq!(refusal_delay_bounds(2, 100), (100, 800));
+		let mut previous = 0;
+		for attempt in 0..8 {
+			let next = ceiling(attempt);
+			assert!(next >= previous, "attempt {attempt} shrank its window");
+			previous = next;
+		}
+		assert_eq!(ceiling(5), MAX_RECONNECT_DELAY_MS, "the ceiling is bounded");
+		assert_eq!(ceiling(64), MAX_RECONNECT_DELAY_MS, "the shift saturates");
+	}
+
+	#[test]
+	fn a_large_hint_keeps_its_own_growth() {
+		assert_eq!(refusal_delay_bounds(0, 5_000), (5_000, 10_000));
+		assert_eq!(refusal_delay_bounds(3, 5_000), (5_000, 10_000));
+		assert!(delay_ms(0) >= 100);
+	}
+
+	#[test]
+	fn the_lost_threshold_caps_every_wait() {
+		let cap = Duration::from_millis((40_000 - 1) / 2);
+		for attempt in 0..12 {
+			assert!(reconnect_delay(attempt, Some(5_000), 40_000) <= cap);
+			assert!(reconnect_delay(attempt, None, 40_000) <= cap);
+		}
+	}
+
+	#[test]
+	fn a_registered_connection_resets_the_refusal_streak() {
+		let capped = 20;
+		assert_eq!(next_attempt(capped, false, true), 0);
+		assert_eq!(next_attempt(capped, true, false), 0);
+		assert_eq!(next_attempt(capped, false, false), capped);
+		assert_eq!(
+			refusal_delay_bounds(next_attempt(capped, false, true), 100),
+			refusal_delay_bounds(0, 100)
+		);
+	}
