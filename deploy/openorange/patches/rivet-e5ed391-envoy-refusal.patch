+fn refusal_delay_bounds(attempt: u32, hint: u64) -> (u64, u64) {
+	let cap = MAX_RECONNECT_DELAY_MS.max(hint.saturating_mul(2));
+	let ceiling = hint
+		.saturating_mul(1u64 << attempt.saturating_add(1).min(32))
+		.min(cap);
+	(hint, ceiling)
+}
