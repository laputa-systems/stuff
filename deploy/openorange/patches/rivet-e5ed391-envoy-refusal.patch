+/// Runs the disconnect writes for a connection whose pool admission or record write landed.
+async fn disconnect_registered<W, Fut, S, FutS>(
+	record: &Mutex<crate::envoy_record::RecordState>,
+	pool_admitted: bool,
+	mut write: W,
+	mut sleep: S,
+) where
+	W: FnMut() -> Fut,
+	Fut: std::future::Future<Output = Result<()>>,
+	S: FnMut(std::time::Duration) -> FutS,
+	FutS: std::future::Future<Output = Result<(), rivet_env::ClockError>>,
+{
+	const ATTEMPTS: u32 = 4;
+	if !pool_admitted && !record.lock().await.connected {
+		return;
+	}
+	let mut backoff = std::time::Duration::from_millis(100);
+	for attempt in 1..=ATTEMPTS {
+		match write().await {
 			Ok(()) => return,
 			Err(error) if error.is::<crate::envoy_record::Superseded>() => return,
 			Err(error) if attempt == ATTEMPTS => {
@@ -699,13 +722,74 @@ async fn disconnect(ctx: &EngineContext, conn: &Connection) {
 				tracing::debug!(?error, attempt, "retrying envoy disconnect write");
 			}
 		}
-		if rivet_env::sleep(clock.as_ref(), backoff).await.is_err() {
+		if sleep(backoff).await.is_err() {
 			return;
 		}
 		backoff *= 2;
 	}
 }
 
+#[cfg(test)]
+mod disconnect_tests {
+	use super::*;
+	use crate::envoy_record::RecordState;
+	use std::sync::atomic::{AtomicUsize, Ordering};
+
+	fn record(connected: bool) -> Mutex<RecordState> {
+		let mut state = RecordState::new(None, "envoy".to_owned(), vec![1], vec![2], 3, 1_000);
+		state.connected = connected;
+		Mutex::new(state)
+	}
+
+	#[tokio::test]
+	async fn a_refused_connect_writes_no_disconnect() {
+		let record = record(false);
+		let writes = AtomicUsize::new(0);
+		let sleeps = AtomicUsize::new(0);
+		disconnect_registered(
+			&record,
+			false,
+			|| async {
+				writes.fetch_add(1, Ordering::SeqCst);
+				Ok(())
+			},
+			|_| async {
+				sleeps.fetch_add(1, Ordering::SeqCst);
+				Ok(())
+			},
+		)
+		.await;
+		assert_eq!(writes.load(Ordering::SeqCst), 0, "an unregistered connect must not write");
+		assert_eq!(sleeps.load(Ordering::SeqCst), 0, "nothing to retry means no wait");
+	}
+
+	async fn disconnect_writes(connected: bool, pool_admitted: bool) -> usize {
+		let record = record(connected);
+		let writes = AtomicUsize::new(0);
+		disconnect_registered(
+			&record,
+			pool_admitted,
+			|| async {
+				writes.fetch_add(1, Ordering::SeqCst);
+				Ok(())
+			},
+			|_| async { Ok(()) },
+		)
+		.await;
+		writes.load(Ordering::SeqCst)
+	}
+
+	#[tokio::test]
+	async fn a_registered_connect_writes_its_disconnect() {
+		assert_eq!(disconnect_writes(true, true).await, 1, "a registered connect clears its record once");
+	}
+
+	#[tokio::test]
+	async fn an_admitted_connect_whose_record_write_failed_releases_its_pool_lease() {
+		assert_eq!(disconnect_writes(false, true).await, 1, "a landed pool admission must be released");
+	}
+}
