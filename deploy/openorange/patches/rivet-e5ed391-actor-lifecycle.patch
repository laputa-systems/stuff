+#[cfg(test)]
+mod lifecycle_tests {
+	use super::*;
+
+	fn allocation() -> wire::ActorAllocation {
+		wire::ActorAllocation {
+			envoy_key: "fixture-envoy".into(),
+			worker_id: vec![1; 16].into(),
+			connection_id: vec![2; 16].into(),
+		}
+	}
+
+	fn response(phase: Option<wire::ActorPhase>, epoch: u32) -> wire::ActorReadResponse {
+		wire::ActorReadResponse {
+			data: Some(wire::ActorData {
+				actor_id: Id::V1([0; 18]).as_bytes().into(),
+				pool_name: "fixture-pool".into(),
+				name: "observation-store".into(),
+				key: Some("stats".into()),
+				input: None,
+				create_unix_ms: 123,
+				legacy_namespace: None,
+				forked_from: None,
+				legacy_moved_from: None,
+			}),
+			phase,
+			epoch,
+			database_origin: None,
+			command_index: Some(0),
+			legacy_move: None,
+			legacy_write_index_phase: None,
+		}
+	}
+
+	#[test]
+	fn actor_reads_preserve_positive_lifecycle_and_unknowns_without_inventing_times() {
+		let cases = [
+			(None, Value::Null, Value::Null),
+			(Some(wire::ActorPhase::Running(wire::Running { allocation: allocation() })), json!("running"), json!(7)),
+			(Some(wire::ActorPhase::Sleeping(wire::Sleeping { wake_retries: 0 })), json!("sleeping"), json!(7)),
+			(Some(wire::ActorPhase::Destroyed), json!("destroyed"), json!(7)),
+			(Some(wire::ActorPhase::MigratingFromV2(wire::MigratingFromV2 {
+				migration_id: 3, reserve_epoxy: None, alarm_due: false,
+			})), json!("migrating_from_v2"), Value::Null),
+		];
+		for (phase, expected_phase, expected_epoch) in cases {
+			let actor = read_actor_of(response(phase, 7)).unwrap();
+			let mut expected = actor_json(&actor.data, "private-fixture", None).unwrap();
+			expected["lifecycle_phase"] = expected_phase;
+			expected["lifecycle_epoch"] = expected_epoch;
+			let actual = read_actor_json(&actor, "private-fixture", None).unwrap();
+			assert_eq!(actual, expected);
+			for field in ["sleep_ts", "start_ts", "connectable_ts"] {
+				assert_eq!(actual[field], Value::Null);
+			}
+		}
+	}
+
+	#[test]
+	fn a_lifecycle_transition_keeps_the_engine_epoch_instead_of_a_constructor_count() {
+		let before = read_actor_of(response(Some(wire::ActorPhase::Running(wire::Running { allocation: allocation() })), 6)).unwrap();
+		let asleep = read_actor_of(response(Some(wire::ActorPhase::Sleeping(wire::Sleeping { wake_retries: 0 })), 7)).unwrap();
+		let awake = read_actor_of(response(Some(wire::ActorPhase::Running(wire::Running { allocation: allocation() })), 7)).unwrap();
+		let observations = [before, asleep, awake].map(|actor| read_actor_json(&actor, "private-fixture", None).unwrap());
+		assert_eq!(observations.each_ref().map(|value| value["lifecycle_phase"].clone()), [json!("running"), json!("sleeping"), json!("running")]);
+		assert_eq!(observations.each_ref().map(|value| value["lifecycle_epoch"].clone()), [json!(6), json!(7), json!(7)]);
+	}
+}
