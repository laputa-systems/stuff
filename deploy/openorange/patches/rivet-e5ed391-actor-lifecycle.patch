+fn lifecycle_of(phase: Option<&wire::ActorPhase>, epoch: u32) -> (Option<&'static str>, Option<u32>) {
+	match phase {
+		None => (None, None),
+		Some(wire::ActorPhase::Initializing(_)) => (Some("initializing"), Some(epoch)),
+		Some(wire::ActorPhase::Starting(_)) => (Some("starting"), Some(epoch)),
+		Some(wire::ActorPhase::Running(_)) => (Some("running"), Some(epoch)),
+		Some(wire::ActorPhase::Stopping(_)) => (Some("stopping"), Some(epoch)),
+		Some(wire::ActorPhase::Sleeping(_)) => (Some("sleeping"), Some(epoch)),
+		Some(wire::ActorPhase::Destroying(_)) => (Some("destroying"), Some(epoch)),
+		Some(wire::ActorPhase::Destroyed) => (Some("destroyed"), Some(epoch)),
+		Some(wire::ActorPhase::MigratingFromV2(_)) => (Some("migrating_from_v2"), None),
+		Some(wire::ActorPhase::DelegatedToV2) => (Some("delegated_to_v2"), None),
+	}
+}
+
+fn read_actor_json(actor: &ReadActor, namespace: &str, destroy_unix_ms: Option<i64>) -> Result<Value> {
+	let mut value = actor_json(&actor.data, namespace, destroy_unix_ms)?;
+	value["lifecycle_phase"] = json!(actor.lifecycle_phase);
+	value["lifecycle_epoch"] = json!(actor.lifecycle_epoch);
+	Ok(value)
+}
