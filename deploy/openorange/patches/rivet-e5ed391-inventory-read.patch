+#[cfg(test)]
+mod inventory_tests {
+	use super::*;
+	use std::cell::Cell;
+
+	fn refused() -> anyhow::Error {
+		depot_client::Overloaded { reason: "volume_transition".into(), retry_after_ms: 1 }.build()
+	}
+
+	#[tokio::test]
+	async fn a_refused_page_returns_the_complete_page_and_original_cursor() {
+		let env = rivet_env::ProductionEnv::new().unwrap();
+		let budget = pegboard_gateway::RetryBudget::new(0, 10);
+		let calls = Cell::new(0);
+		let expected = json!({ "actors": [{ "id": "actor-one" }], "pagination": { "cursor": "next-page" } });
+		let actual = inventory_read(&env, &budget, || {
+			calls.set(calls.get() + 1);
+			std::future::ready(if calls.get() < 3 { Err(refused()) } else { Ok(expected.clone()) })
+		}).await.unwrap();
+		assert_eq!(actual, expected);
+		assert_eq!(calls.get(), 3);
+	}
+
+	#[tokio::test]
+	async fn an_uncertain_error_is_returned_without_replaying_the_read() {
+		let env = rivet_env::ProductionEnv::new().unwrap();
+		let budget = pegboard_gateway::RetryBudget::new(0, 10);
+		let calls = Cell::new(0);
+		let error = inventory_read(&env, &budget, || {
+			calls.set(calls.get() + 1);
+			std::future::ready(Err::<Value, _>(depot_client::Unavailable { reason: "unknown outcome".into() }.build()))
+		}).await.unwrap_err();
+		assert_eq!(calls.get(), 1);
+		assert_eq!(rivet_error::RivetError::extract(&error).code(), "unavailable");
+	}
+
+	#[tokio::test]
+	async fn persistent_refusals_stop_at_the_request_cap_and_keep_the_hint() {
+		let env = rivet_env::ProductionEnv::new().unwrap();
+		let budget = pegboard_gateway::RetryBudget::new(0, 100);
+		let calls = Cell::new(0);
+		let error = inventory_read(&env, &budget, || {
+			calls.set(calls.get() + 1);
+			std::future::ready(Err::<Value, _>(refused()))
+		}).await.unwrap_err();
+		assert_eq!(calls.get(), 5);
+		assert_eq!(depot_client::retry_after_ms(&error), Some(1));
+	}
+
+	#[tokio::test]
+	async fn requests_share_the_process_budget() {
+		let env = rivet_env::ProductionEnv::new().unwrap();
+		let budget = pegboard_gateway::RetryBudget::new(0, 2);
+		for expected_calls in [3, 1] {
+			let calls = Cell::new(0);
+			let error = inventory_read(&env, &budget, || {
+				calls.set(calls.get() + 1);
+				std::future::ready(Err::<Value, _>(refused()))
+			}).await.unwrap_err();
+			assert_eq!(calls.get(), expected_calls);
+			assert_eq!(depot_client::retry_after_ms(&error), Some(1));
+		}
+	}
+
+	#[tokio::test]
+	async fn a_hint_beyond_the_deadline_is_not_retried() {
+		let env = rivet_env::ProductionEnv::new().unwrap();
+		let budget = pegboard_gateway::RetryBudget::new(0, 10);
+		let calls = Cell::new(0);
+		let error = inventory_read(&env, &budget, || {
+			calls.set(calls.get() + 1);
+			std::future::ready(Err::<Value, _>(depot_client::Overloaded {
+				reason: "volume_transition".into(), retry_after_ms: 60_000,
+			}.build()))
+		}).await.unwrap_err();
+		assert_eq!(calls.get(), 1);
+		assert_eq!(depot_client::retry_after_ms(&error), Some(60_000));
+	}
+
+	#[tokio::test]
+	async fn a_stalled_read_returns_the_existing_deadline_error() {
+		let env = rivet_env::ProductionEnv::new().unwrap();
+		let budget = pegboard_gateway::RetryBudget::new(0, 10);
+		let error = inventory_read(&env, &budget, std::future::pending::<Result<Value>>).await.unwrap_err();
+		assert_eq!(rivet_error::RivetError::extract(&error).code(), "request_deadline_exceeded");
+	}
+
+	#[tokio::test]
+	async fn exhausted_refusals_keep_the_wire_error_and_method_specific_status() {
+		use axum::{body::Body, middleware, routing::get, Router};
+		use tower::ServiceExt;
+
+		async fn handler() -> Result<Json<Value>, ApiError> {
+			let env = rivet_env::ProductionEnv::new().unwrap();
+			let budget = pegboard_gateway::RetryBudget::new(0, 0);
+			Ok(Json(inventory_read(&env, &budget, || std::future::ready(Err::<Value, _>(
+				depot_client::Overloaded { reason: "volume_transition".into(), retry_after_ms: 100 }.build(),
+			))).await?))
+		}
+
+		let app = Router::new().route("/actors", get(handler).post(handler))
+			.layer(middleware::from_fn(crate::classify_retry_safe_refusal));
+		for (method, status) in [("GET", 503), ("POST", 400)] {
+			let response = app.clone().oneshot(http::Request::builder()
+				.method(method).uri("/actors").body(Body::empty()).unwrap()).await.unwrap();
+			assert_eq!(response.status().as_u16(), status);
+			assert_eq!(response.headers()["x-rivet-error"], "depot.overloaded");
+			assert_eq!(response.headers()["retry-after"], "1");
+			let body = axum::body::to_bytes(response.into_body(), 4096).await.unwrap();
+			let actual: Value = serde_json::from_slice(&body).unwrap();
+			assert_eq!(actual["group"], "depot");
+			assert_eq!(actual["code"], "overloaded");
+			assert_eq!(actual["metadata"], json!({ "reason": "volume_transition", "retry_after_ms": 100 }));
+		}
+	}
+}
