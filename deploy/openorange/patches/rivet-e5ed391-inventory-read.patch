+async fn inventory_read<T, F, Fut>(
+	env: &dyn rivet_env::Env,
+	budget: &pegboard_gateway::RetryBudget,
+	read: F,
+) -> Result<T>
+where
+	F: FnMut() -> Fut,
+	Fut: std::future::Future<Output = Result<T>>,
+{
+	let clock = env.clock();
+	let deadline = rivet_env::deadline_after(clock.as_ref(), INVENTORY_READ_TIMEOUT)?;
+	budget.deposit();
+	let mut retries = budget.retries(deadline);
+	match rivet_env::timeout_at(
+		clock.as_ref(),
+		deadline,
+		storage_step(env, &mut retries, "actor_inventory", read),
+	).await {
+		Ok(result) => result,
+		Err(rivet_env::TimeoutError::Elapsed) => Err(depot_client::RequestDeadlineExceeded.build()),
+		Err(rivet_env::TimeoutError::Clock(error)) => Err(error.into()),
+	}
+}
