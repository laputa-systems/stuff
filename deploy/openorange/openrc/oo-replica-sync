#!/sbin/openrc-run
# Replica sync for the registry failover Worker.
#
# Keeps the R2 replica of the six registry buckets within one cadence of the
# OpenOrange store. deploy/replica-sync.sh owns the loop; this unit supervises
# it. Credentials come from the root-only /etc/openorange/replica-sync.env.
#
# Install:
#   install -m 0755 openrc/oo-replica-sync /etc/init.d/oo-replica-sync
#   install -m 0755 replica-sync.sh /opt/openorange/replica-sync.sh
#   install -m 0700 replica-sync.env /etc/openorange/replica-sync.env
#   rc-update add oo-replica-sync default
#   rc-service oo-replica-sync start

description="OpenOrange registry replica sync to R2"
supervisor=supervise-daemon
command=/bin/sh
command_args="/opt/openorange/replica-sync.sh --interval 300"
respawn_delay=5
respawn_max=0
respawn_period=60
output_log="/var/log/openorange/replica-sync.log"
error_log="/var/log/openorange/replica-sync.log"
retry="TERM/30/KILL/5"

depend() {
	need net oo-store
	after oo-store
}

start_pre() {
	[ -r /etc/openorange/replica-sync.env ] || { eerror "missing /etc/openorange/replica-sync.env"; return 1; }
	[ -x /opt/openorange/replica-sync.sh ] || { eerror "missing /opt/openorange/replica-sync.sh"; return 1; }
	checkpath --directory --mode 0700 /var/lib/openorange/replica-sync
}
